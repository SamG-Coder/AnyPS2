cmake_minimum_required(VERSION 3.24)

# Repeatable local integration check of an existing converted project. Every
# process receives an argument vector; no command shell or generated game edits.
set(required_paths SOURCE_ROOT NATIVE_BUILD NATIVE_DATA DISC)
if(DEFINED IOP_INPUTS_JSON)
    list(APPEND required_paths IOP_INPUTS_JSON NATIVE_PROJECT)
else()
    list(APPEND required_paths IOP_DATA)
endif()
foreach(required IN LISTS required_paths)
    if(NOT DEFINED ${required} OR NOT EXISTS "${${required}}")
        message(FATAL_ERROR "${required} must name an existing local path")
    endif()
endforeach()
if(NOT DEFINED RELATED_TESTS OR RELATED_TESTS STREQUAL "")
    message(FATAL_ERROR "RELATED_TESTS must explicitly select the affected CTest tests")
endif()
if(NOT DEFINED TEST_BUILD)
    set(TEST_BUILD "${SOURCE_ROOT}/build")
endif()
if(NOT DEFINED TEST_TARGETS)
    message(FATAL_ERROR "TEST_TARGETS must select the affected build targets")
endif()
if(NOT DEFINED OUTPUT_ROOT)
    set(OUTPUT_ROOT "${SOURCE_ROOT}/work/native-validation")
endif()
foreach(setting JOBS RUN_SECONDS OPERATION_BUDGET)
    if(DEFINED ${setting} AND NOT "${${setting}}" MATCHES "^[1-9][0-9]*$")
        message(FATAL_ERROR "${setting} must be a positive integer")
    endif()
endforeach()
if(NOT DEFINED JOBS)
    set(JOBS 4)
endif()
if(NOT DEFINED RUN_SECONDS)
    set(RUN_SECONDS 120)
endif()
if(NOT DEFINED OPERATION_BUDGET)
    set(OPERATION_BUDGET 5000000000)
endif()
if(NOT DEFINED NATIVE_EXE)
    set(NATIVE_EXE "${NATIVE_BUILD}/Release/ps2-native.exe")
endif()
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
string(TIMESTAMP stamp "%Y%m%d-%H%M%S" UTC)
string(RANDOM LENGTH 6 ALPHABET 0123456789abcdef suffix)
set(output "${OUTPUT_ROOT}/${stamp}-${suffix}")
file(MAKE_DIRECTORY "${output}")
message(STATUS "Native validation records: ${output}")

function(stage name)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE status
        OUTPUT_FILE "${output}/${name}.log" ERROR_FILE "${output}/${name}.log")
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "${name} failed (${status}); see ${output}/${name}.log")
    endif()
endfunction()
stage(test-build "${CMAKE_COMMAND}" --build "${TEST_BUILD}" --config Release --target ${TEST_TARGETS} --parallel "${JOBS}")
stage(tests "${CMAKE_CTEST_COMMAND}" --test-dir "${TEST_BUILD}" -C Release -R "${RELATED_TESTS}" --no-tests=error --output-on-failure)
if(DEFINED IOP_INPUTS_JSON)
    # The same explicit module arguments accepted by ps2-iop-recompile, kept
    # outside Git. Regeneration is optional for native-service-only iterations.
    file(READ "${IOP_INPUTS_JSON}" inputs_json)
    string(JSON count LENGTH "${inputs_json}")
    if(count LESS 1)
        message(FATAL_ERROR "IOP_INPUTS_JSON must be a nonempty argument array")
    endif()
    math(EXPR last "${count}-1")
    set(inputs)
    foreach(index RANGE 0 ${last})
        string(JSON item GET "${inputs_json}" ${index})
        list(APPEND inputs "${item}")
    endforeach()
    stage(iop-generation "${TEST_BUILD}/Release/ps2-iop-recompile.exe" --bundle "${output}/iop" ${inputs})
    stage(configure "${CMAKE_COMMAND}" -S "${NATIVE_PROJECT}" -B "${NATIVE_BUILD}"
        "-DANYPS2_ROOT=${SOURCE_ROOT}" "-DANYPS2_IOP_PROJECT=${output}/iop")
    set(IOP_DATA "${output}/iop/module.data")
endif()
stage(native-build "${CMAKE_COMMAND}" --build "${NATIVE_BUILD}" --config Release --target ps2-native --parallel "${JOBS}")
if(NOT EXISTS "${NATIVE_EXE}")
    message(FATAL_ERROR "Native build did not produce ${NATIVE_EXE}")
endif()
math(EXPR timeout "${RUN_SECONDS}+30")
execute_process(COMMAND "${NATIVE_EXE}" "${NATIVE_DATA}" "${OPERATION_BUDGET}"
    --disc "${DISC}" --iop-reset-session "${IOP_DATA}" --headless
    --run-seconds "${RUN_SECONDS}" --capture-stop "${output}/capture"
    RESULT_VARIABLE run_status TIMEOUT "${timeout}"
    OUTPUT_FILE "${output}/native.log" ERROR_FILE "${output}/native.log")
if(NOT run_status MATCHES "^(0|3|4)$" OR NOT EXISTS "${output}/capture/capture.txt")
    message(FATAL_ERROR "Native execution failed or did not capture a boundary (${run_status}); see ${output}/native.log")
endif()
if(DEFINED INSPECT_MODULE OR DEFINED INSPECT_INPUTS_JSON OR DEFINED IOP_INPUTS_JSON)
    if(DEFINED INSPECT_INPUTS_JSON)
        file(READ "${INSPECT_INPUTS_JSON}" inspection_json)
        string(JSON inspection_count LENGTH "${inspection_json}")
        math(EXPR inspection_last "${inspection_count}-1")
        set(inputs)
        foreach(index RANGE 0 ${inspection_last})
            string(JSON item GET "${inspection_json}" ${index})
            list(APPEND inputs "${item}")
        endforeach()
    endif()
    if(NOT DEFINED INSPECT_BASE AND NOT inputs)
        message(FATAL_ERROR "INSPECT_BASE is required with INSPECT_MODULE")
    endif()
    if(NOT DEFINED INSPECT_RADIUS)
        set(INSPECT_RADIUS 0x1000)
    endif()
    if(inputs)
        set(inspect_arguments --bundle "${output}/neighborhood.md" --capture "${output}/capture" --radius "${INSPECT_RADIUS}" --modules ${inputs})
    else()
        set(inspect_arguments "${INSPECT_MODULE}" "${INSPECT_BASE}" "${output}/neighborhood.md" --capture "${output}/capture" --radius "${INSPECT_RADIUS}")
    endif()
    execute_process(COMMAND "${TEST_BUILD}/Release/ps2-iop-inspect.exe" ${inspect_arguments} RESULT_VARIABLE inspection_status
        OUTPUT_FILE "${output}/neighborhood.log" ERROR_FILE "${output}/neighborhood.log")
    if(NOT inspection_status STREQUAL "0")
        message(WARNING "Neighborhood unavailable (${inspection_status}); preserved native boundary and neighborhood.log")
    endif()
endif()
file(READ "${output}/native.log" log)
string(REGEX MATCH "\nstop=[^\r\n]+" ee "${log}")
string(REGEX MATCH "iop_reset_accepted=[^\r\n]+" iop "${log}")
string(REGEX MATCH "execution_seconds=[^\r\n]+" timing "${log}")
string(REGEX MATCH "graphics_draws=[0-9]+" drawing "${log}")
string(STRIP "${ee}" ee)
if(ee STREQUAL "" OR iop STREQUAL "")
    message(FATAL_ERROR "Native log lacks complete EE/IOP boundary diagnostics: ${output}/native.log")
endif()
set(boundary "")
foreach(domain ee iop)
    foreach(field stop reason pc address trap syscall)
        string(REGEX MATCH "(^| )${field}=([^ ]+)" match "${${domain}}")
        if(match)
            string(APPEND boundary "${domain}.${field}=${CMAKE_MATCH_2}\n")
        endif()
    endforeach()
endforeach()
# Registers help distinguish different calls at the same imported entry. This
# detects a changed observation only; it never calls that change boot progress.
if(EXISTS "${output}/capture/iop-cpu.txt")
    file(READ "${output}/capture/iop-cpu.txt" registers)
    foreach(index 4 5 6 7 31)
        string(REGEX MATCH "gpr${index}=[0-9]+" value "${registers}")
        string(APPEND boundary "iop.${value}\n")
    endforeach()
endif()
set(comparison "no_previous_observation")
if(EXISTS "${OUTPUT_ROOT}/latest-boundary.txt")
    file(READ "${OUTPUT_ROOT}/latest-boundary.txt" previous)
    if(previous STREQUAL boundary)
        set(comparison "same_boundary_no_verified_forward_progress")
    else()
        set(comparison "changed_boundary_requires_review")
    endif()
    if(EXISTS "${OUTPUT_ROOT}/latest-summary.txt")
        configure_file("${OUTPUT_ROOT}/latest-summary.txt" "${output}/previous-summary.txt" COPYONLY)
    endif()
endif()
set(summary "comparison=${comparison}\nnative_exit=${run_status}\n${ee}\n${iop}\n${timing}\n${drawing}\n")
file(WRITE "${output}/boundary.txt" "${boundary}")
file(WRITE "${output}/summary.txt" "${summary}")
file(WRITE "${OUTPUT_ROOT}/latest-boundary.txt" "${boundary}")
file(WRITE "${OUTPUT_ROOT}/latest-summary.txt" "${summary}")
file(WRITE "${OUTPUT_ROOT}/latest-path.txt" "${output}\n")
message(STATUS "${comparison}; native exit ${run_status}. This does not establish title-screen or gameplay success.")
message(STATUS "${ee}")
message(STATUS "${drawing}; see ${output}/summary.txt and capture/")
