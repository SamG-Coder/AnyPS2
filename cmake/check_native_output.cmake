cmake_minimum_required(VERSION 3.24)
if(NOT REPORT)
    message(FATAL_ERROR "Native output audit requires a report path")
endif()
file(REMOVE "${REPORT}")
if(NOT EXISTS "${EXECUTABLE}" OR NOT EXISTS "${MAP_FILE}" OR NOT EXISTS "${DUMPBIN}")
    message(FATAL_ERROR "Native output audit requires the executable, linker map and dumpbin")
endif()
file(READ "${MAP_FILE}" link_map)
string(TOLOWER "${link_map}" lower_map)
if(NOT lower_map MATCHES "nt_ee_generated_run" OR NOT lower_map MATCHES "generated\\.obj")
    message(FATAL_ERROR "Native output map has no compiled EE entry/object evidence")
endif()
# Known offline/compiler/diagnostic libraries must never enter the executable.
set(forbidden "nt_runtime" "nt_hardware" "nt_kernel" "nt_iop" "nt_r5900"
    "nt_analysis" "nt_ee_codegen" "nt_vu" "pcsx2" "llvmorcjit" "llvmmcjit" "llvmexecutionengine")
foreach(library IN LISTS forbidden)
    if(lower_map MATCHES "${library}(\\.(lib|dll|a))?[(: \r\n]")
        message(FATAL_ERROR "Native output links forbidden runtime dependency: ${library}")
    endif()
endforeach()
# Also catch known functions if diagnostic sources are linked as loose objects.
foreach(symbol IN ITEMS "decode@r5900@nt" "decode@iop@nt" "decode@vu@nt" "run@iop@nt" "step@runtime@nt")
    string(FIND "${lower_map}" "${symbol}" found)
    if(NOT found EQUAL -1)
        message(FATAL_ERROR "Native output contains forbidden execution/decoder symbol: ${symbol}")
    endif()
endforeach()
execute_process(COMMAND "${DUMPBIN}" /NOLOGO /DEPENDENTS "${EXECUTABLE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE dependencies ERROR_VARIABLE diagnostic TIMEOUT 30)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot inspect native executable dependencies: ${diagnostic}")
endif()
string(TOLOWER "${dependencies}" lower_dependencies)
if(lower_dependencies MATCHES "(pcsx2[^ \r\n]*|llvm[^ \r\n]*|nt_(runtime|hardware|iop|r5900|vu))\\.dll")
    message(FATAL_ERROR "Native executable imports an emulator/compiler runtime DLL")
endif()
file(SHA256 "${EXECUTABLE}" executable_hash)
file(SHA256 "${MAP_FILE}" map_hash)
file(WRITE "${REPORT}" "AnyPS2 native output dependency audit passed\nExecutable SHA256: ${executable_hash}\nLink map SHA256: ${map_hash}\nKnown forbidden libraries/symbols absent; compiled EE entry present.\nThis guard does not prove arbitrary linked code is interpreter-free.\n${dependencies}")
message(STATUS "Native output dependency audit passed: ${REPORT}")
