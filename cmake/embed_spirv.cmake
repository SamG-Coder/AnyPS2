file(READ "${INPUT}" data HEX)
string(LENGTH "${data}" length)
math(EXPR remainder "${length} % 8")
if(NOT remainder EQUAL 0)
    message(FATAL_ERROR "SPIR-V has an incomplete word")
endif()
set(output "{")
set(offset 0)
while(offset LESS length)
    string(SUBSTRING "${data}" ${offset} 8 word)
    string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1U," word "${word}")
    string(APPEND output "${word}")
    math(EXPR offset "${offset} + 8")
endwhile()
string(APPEND output "}\n")
file(WRITE "${OUTPUT}" "${output}")
