cmake_minimum_required(VERSION 3.24)

# Deliberately allow only reviewable source/documentation paths. This guard does
# not determine the provenance or copyright status of arbitrary source text.
function(check_content relative physical)
    string(TOLOWER "${relative}" lower)
    if(NOT lower MATCHES "^(libraries|programs|tests)/[a-z0-9_./-]+\\.(cpp|hpp|h|cmake)$"
       AND NOT lower MATCHES "^docs/[a-z0-9_./-]+\\.md$"
       AND NOT lower STREQUAL "docs/third-party/play-license.txt"
       AND NOT lower MATCHES "^(cmakelists\\.txt|readme\\.md|agents\\.md|disclaimer\\.md|\\.agent|\\.gitignore)$")
        message(FATAL_ERROR "Repository policy: unapproved path: ${relative}")
    endif()
    if(lower MATCHES "(^|/)(generated|native-fixture)\\.cpp$" OR IS_SYMLINK "${physical}")
        message(FATAL_ERROR "Repository policy: generated artifact or symlink: ${relative}")
    endif()
    file(SIZE "${physical}" size)
    if(size GREATER 524288)
        message(FATAL_ERROR "Repository policy: oversized source requires provenance review: ${relative}")
    endif()
    file(READ "${physical}" bytes HEX)
    # A NUL is not allowed in these text sources. Match byte pairs, not nibbles.
    if(bytes MATCHES "^(..)*00" OR bytes MATCHES "^(7f454c46|4d5a|504b0304)")
        message(FATAL_ERROR "Repository policy: binary content: ${relative}")
    endif()
    file(READ "${physical}" prefix LIMIT 1024)
    if(prefix MATCHES "^// Generated by (AnyPS2|NativeTrismo)")
        message(FATAL_ERROR "Repository policy: generated guest code: ${relative}")
    endif()
endfunction()

if(DEFINED CHECK_FILE)
    check_content("${CHECK_NAME}" "${CHECK_FILE}")
    return()
endif()

find_package(Git REQUIRED)
if(NOT DEFINED ROOT OR NOT DEFINED SCRATCH)
    message(FATAL_ERROR "ROOT and SCRATCH are required")
endif()
file(MAKE_DIRECTORY "${SCRATCH}")
# Check current candidates, including untracked files, and separately check the
# actual index blobs so a clean working copy cannot conceal a staged artifact.
foreach(kind IN ITEMS working index)
    if(kind STREQUAL "working")
        set(arguments ls-files --cached --others --exclude-standard)
    else()
        set(arguments ls-files --cached)
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -c core.quotePath=true ${arguments}
        WORKING_DIRECTORY "${ROOT}" OUTPUT_VARIABLE paths RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Cannot inspect Git ${kind} content")
    endif()
    string(REPLACE "\n" ";" paths "${paths}")
    list(FILTER paths EXCLUDE REGEX "^$")
    foreach(path IN LISTS paths)
        if(kind STREQUAL "index")
            execute_process(COMMAND "${GIT_EXECUTABLE}" show ":${path}"
                WORKING_DIRECTORY "${ROOT}" OUTPUT_FILE "${SCRATCH}/index-content"
                ERROR_QUIET RESULT_VARIABLE result)
            if(NOT result EQUAL 0)
                message(FATAL_ERROR "Cannot read staged content: ${path}")
            endif()
            check_content("${path}" "${SCRATCH}/index-content")
        elseif(EXISTS "${ROOT}/${path}")
            check_content("${path}" "${ROOT}/${path}")
        endif()
    endforeach()
endforeach()
message(STATUS "Repository candidates and index passed content checks; provenance still requires review")
