cmake_minimum_required(VERSION 3.24)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(run "${SCRATCH}/${id}")
file(MAKE_DIRECTORY "${run}")
execute_process(COMMAND "${FIXTURE}" "${run}/fixture.ll" "${run}/fixture.elf" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Flow verification fixture generation failed")
endif()
function(verify input output expected)
    execute_process(COMMAND "${CONVERTER}" "${run}/fixture.elf.${input}" "${run}/${output}" --verify-only ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
    if(NOT status EQUAL expected)
        message(FATAL_ERROR "Flow verification returned ${status}, expected ${expected}: ${out} ${err}")
    endif()
endfunction()
verify(flow-direct direct 0)
file(READ "${run}/direct/flow-verification.txt" summary)
if(NOT summary MATCHES "known_flow=closed" OR NOT summary MATCHES "runtime_executed=0")
    message(FATAL_ERROR "Direct reached-flow verification differs: ${summary}")
endif()
verify(flow-unlinked gaps 2)
file(READ "${run}/gaps/flow-verification.txt" summary)
file(READ "${run}/gaps/callback-flow-gaps.tsv" bindings)
file(READ "${run}/gaps/pointer-references.tsv" pointers)
file(READ "${run}/gaps/flow-gaps.tsv" gaps)
file(READ "${run}/gaps/call-sites.tsv" calls)
file(READ "${run}/gaps/discovery-passes.tsv" passes)
if(NOT summary MATCHES "known_flow=incomplete" OR NOT summary MATCHES "unproven_record_bindings=1" OR
   NOT bindings MATCHES "0x00001104[\t]0x000010e0[\t]0x00000018[\t]unproven-object-identity[\t]0x00001084")
    message(FATAL_ERROR "Missing object binding was not reported with its consumer: ${summary} ${bindings}")
endif()
if(bindings MATCHES "0x000010d0" OR
   NOT pointers MATCHES "0x000010e0[^\n]*not-established-as-EE-code" OR
   NOT pointers MATCHES "0x000010d0[^\n]*not-established-as-EE-code")
    message(FATAL_ERROR "Verification promoted a layout match or confused the opaque context: ${bindings} ${pointers}")
endif()
if(NOT gaps MATCHES "unresolved-indirect[\t]0x00001084" OR NOT gaps MATCHES "unclassified-pointer[\t]0x00001104" OR
   calls MATCHES "compiled" OR NOT passes MATCHES "[\t]0[\t]0\n$")
    message(FATAL_ERROR "Incomplete closure or generated/compiled distinction was lost: ${gaps} ${calls} ${passes}")
endif()
file(GLOB emitted "${run}/gaps/*.ll" "${run}/gaps/*.obj" "${run}/gaps/*.exe")
if(emitted OR EXISTS "${run}/gaps/program.data" OR EXISTS "${run}/gaps/CMakeLists.txt")
    message(FATAL_ERROR "Verify-only emitted game output or a native build")
endif()
verify(pointer-flow-unsupported unsupported 2)
file(READ "${run}/unsupported/flow-verification.txt" summary)
file(READ "${run}/unsupported/lowering-diagnostics.txt" lowering)
if(NOT summary MATCHES "lowering_supported=0" OR lowering STREQUAL "")
    message(FATAL_ERROR "Reached unsupported instructions were hidden: ${summary} ${lowering}")
endif()
verify(loader overlap 1 --image "${run}/fixture.elf.loader")
if(EXISTS "${run}/overlap")
    message(FATAL_ERROR "Overlapping images published a verification report")
endif()
verify(flow-direct direct 1)
file(READ "${run}/direct/flow-verification.txt" preserved)
if(NOT preserved MATCHES "known_flow=closed")
    message(FATAL_ERROR "An existing verification output was replaced")
endif()
