foreach(variable CONVERTER INPUT SCRATCH)
    if(NOT DEFINED ${variable})
        message(FATAL_ERROR "Missing ${variable}")
    endif()
endforeach()
file(REMOVE_RECURSE "${SCRATCH}")
file(MAKE_DIRECTORY "${SCRATCH}")
execute_process(COMMAND "${CONVERTER}" "${INPUT}" "${SCRATCH}/flow" RESULT_VARIABLE status ERROR_VARIABLE error OUTPUT_QUIET)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Mixed section did not convert: ${error}")
endif()
file(READ "${SCRATCH}/flow/code-coverage.txt" coverage)
# Two proven words, then every lowerable word up to the invalid one.
if(NOT coverage MATCHES "selected_instructions=14\n" OR NOT coverage MATCHES "unverified_ranges=1\n")
    message(FATAL_ERROR "Mixed-section sweep selected the wrong words:\n${coverage}")
endif()
# A mixed section still cannot be declared wholly code.
execute_process(COMMAND "${CONVERTER}" "${INPUT}" "${SCRATCH}/whole" --whole-code RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE error)
if(status EQUAL 0 OR NOT error MATCHES "classify code/data")
    message(FATAL_ERROR "Mixed section was accepted as whole declared code: ${error}")
endif()
