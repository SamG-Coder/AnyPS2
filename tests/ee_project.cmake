cmake_minimum_required(VERSION 3.24)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(run "${SCRATCH}/${run_id}")
file(MAKE_DIRECTORY "${run}")
function(checked)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 90)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "EE pipeline failed (${result}): ${out} ${err}")
    endif()
endfunction()
checked("${FIXTURE}" "${run}/fixture.ll" "${run}/fixture.elf")
foreach(invalid overlap unsupported)
    execute_process(COMMAND "${CONVERTER}" "${run}/fixture.elf.${invalid}" "${run}/${invalid}"
        RESULT_VARIABLE result ERROR_VARIABLE diagnostic)
    if(NOT result EQUAL 1 OR EXISTS "${run}/${invalid}")
        message(FATAL_ERROR "Invalid EE input produced a project: ${diagnostic}")
    endif()
endforeach()
foreach(mapping "0x2004 0x4000 12" "0x1040 0x1000 12" "0x1040 0x4000 11" "0x1040 0x1fffffc 12" "0x1040 0x4000 12 12" "0x1040 0x4000 12 1")
    file(WRITE "${run}/invalid-payload.txt" "${mapping}\n")
    execute_process(COMMAND "${CONVERTER}" "${run}/fixture.elf" "${run}/bad-payload"
        --payloads "${run}/invalid-payload.txt" RESULT_VARIABLE result ERROR_VARIABLE diagnostic)
    if(NOT result EQUAL 1 OR EXISTS "${run}/bad-payload")
        message(FATAL_ERROR "Invalid payload mapping produced output: ${diagnostic}")
    endif()
endforeach()
file(WRITE "${run}/payloads.txt" "0x1040 0x4000 12 4\n")
checked("${CONVERTER}" "${run}/fixture.elf" "${run}/project" --payloads "${run}/payloads.txt")
file(SHA256 "${run}/project/generated.ll" original)
execute_process(COMMAND "${CONVERTER}" "${run}/fixture.elf" "${run}/project" RESULT_VARIABLE result)
file(SHA256 "${run}/project/generated.ll" preserved)
if(NOT result EQUAL 1 OR NOT original STREQUAL preserved)
    message(FATAL_ERROR "EE conversion overwrote an existing project")
endif()
file(READ "${run}/project/CMakeLists.txt" project)
if(project MATCHES "target_link_libraries|add_subdirectory|decoder|runtime.cpp|iop")
    message(FATAL_ERROR "EE output introduced execution scaffolding")
endif()
set(platform)
if(PLATFORM)
    list(APPEND platform -A "${PLATFORM}")
endif()
checked("${CMAKE_COMMAND}" -S "${run}/project" -B "${run}/build" -G "${GENERATOR}"
    ${platform} "-DANYPS2_ROOT=${ROOT}")
checked("${CMAKE_COMMAND}" --build "${run}/build" --config Release --target ps2-native --parallel 2)
set(executable "${run}/build/Release/ps2-native${EXE_SUFFIX}")
file(REMOVE "${run}/fixture.elf")
execute_process(COMMAND "${executable}" "${run}/project/program.data"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT result EQUAL 3 OR NOT out MATCHES "stop=1 pc=0x0000101c executed=10 v0=43")
    message(FATAL_ERROR "Compiled EE ELF execution differs: ${out} ${err}")
endif()
execute_process(COMMAND "${executable}" "${run}/project/program.data" 1
    RESULT_VARIABLE result OUTPUT_VARIABLE out TIMEOUT 10)
if(NOT result EQUAL 4 OR NOT out MATCHES "executed=1")
    message(FATAL_ERROR "EE operation budget was ignored: ${out}")
endif()
file(WRITE "${run}/truncated.data" "short")
execute_process(COMMAND "${executable}" "${run}/truncated.data" RESULT_VARIABLE result ERROR_VARIABLE err TIMEOUT 10)
if(NOT result EQUAL 1 OR NOT err MATCHES "data mismatch")
    message(FATAL_ERROR "EE executable accepted mismatched data")
endif()

checked("${CONVERTER}" "${run}/fixture.elf.startup" "${run}/startup")
checked("${CMAKE_COMMAND}" -S "${run}/startup" -B "${run}/startup-build" -G "${GENERATOR}"
    ${platform} "-DANYPS2_ROOT=${ROOT}")
checked("${CMAKE_COMMAND}" --build "${run}/startup-build" --config Release --target ps2-native --parallel 2)
execute_process(COMMAND "${run}/startup-build/Release/ps2-native${EXE_SUFFIX}" "${run}/startup/program.data"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT result EQUAL 3 OR NOT out MATCHES "stop=1 pc=0x00001040 executed=16 v0=16384 syscall=127")
    message(FATAL_ERROR "Compiled startup service continuation differs: ${out} ${err}")
endif()
