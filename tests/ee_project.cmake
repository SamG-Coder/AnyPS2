cmake_minimum_required(VERSION 3.24)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(run "${SCRATCH}/${run_id}")
file(MAKE_DIRECTORY "${run}")
function(checked)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 90)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "EE pipeline failed (${result}): ${out} ${err}")
    endif()
endfunction()
checked("${FIXTURE}" "${run}/fixture.ll" "${run}/fixture.elf")
foreach(invalid overlap unsupported)
    execute_process(COMMAND "${CONVERTER}" "${run}/fixture.elf.${invalid}" "${run}/${invalid}"
        RESULT_VARIABLE result ERROR_VARIABLE diagnostic)
    if(NOT result EQUAL 1 OR EXISTS "${run}/${invalid}")
        message(FATAL_ERROR "Invalid EE input produced a project: ${diagnostic}")
    endif()
endforeach()
foreach(mapping "0x2004 0x4000 12" "0x1040 0x1000 12" "0x1040 0x4000 11" "0x1040 0x1fffffc 12" "0x1040 0x4000 12 12" "0x1040 0x4000 12 1")
    file(WRITE "${run}/invalid-payload.txt" "${mapping}\n")
    execute_process(COMMAND "${CONVERTER}" "${run}/fixture.elf" "${run}/bad-payload"
        --payloads "${run}/invalid-payload.txt" RESULT_VARIABLE result ERROR_VARIABLE diagnostic)
    if(NOT result EQUAL 1 OR EXISTS "${run}/bad-payload")
        message(FATAL_ERROR "Invalid payload mapping produced output: ${diagnostic}")
    endif()
endforeach()
file(WRITE "${run}/payloads.txt" "0x1040 0x4000 12 4\n")
checked("${CONVERTER}" "${run}/fixture.elf" "${run}/project" --payloads "${run}/payloads.txt")
file(SHA256 "${run}/project/generated.ll" original)
execute_process(COMMAND "${CONVERTER}" "${run}/fixture.elf" "${run}/project" RESULT_VARIABLE result)
file(SHA256 "${run}/project/generated.ll" preserved)
if(NOT result EQUAL 1 OR NOT original STREQUAL preserved)
    message(FATAL_ERROR "EE conversion overwrote an existing project")
endif()
file(READ "${run}/project/CMakeLists.txt" project)
if(project MATCHES "add_subdirectory|decoder|runtime.cpp|nt_runtime|nt_hardware|nt_kernel|nt_iop|iop/src")
    message(FATAL_ERROR "EE output introduced execution scaffolding")
endif()
set(platform)
if(PLATFORM)
    list(APPEND platform -A "${PLATFORM}")
endif()
checked("${CMAKE_COMMAND}" -S "${run}/project" -B "${run}/build" -G "${GENERATOR}"
    ${platform} "-DANYPS2_ROOT=${ROOT}")
checked("${CMAKE_COMMAND}" --build "${run}/build" --config Release --target ps2-native --parallel 2)
set(executable "${run}/build/Release/ps2-native${EXE_SUFFIX}")
if(NOT EXISTS "${executable}.audit.txt" OR NOT EXISTS "${executable}.map")
    message(FATAL_ERROR "Generated EE output has no native dependency audit artifacts")
endif()
file(READ "${executable}.audit.txt" audit)
if(NOT audit MATCHES "dependency audit passed" OR NOT audit MATCHES "Executable SHA256:")
    message(FATAL_ERROR "Native output audit report is incomplete")
endif()
# A forbidden library added to link evidence must fail the same post-link gate.
file(READ "${run}/build/CMakeCache.txt" cache)
string(REGEX MATCH "ANYPS2_DUMPBIN:FILEPATH=([^\r\n]+)" match "${cache}")
set(dumpbin "${CMAKE_MATCH_1}")
file(READ "${executable}.map" clean_map)
file(WRITE "${run}/forbidden.map" "${clean_map}\n nt_runtime:runtime.obj\n")
file(WRITE "${run}/forbidden.audit.txt" "stale success must be removed")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DEXECUTABLE=${executable}"
    "-DMAP_FILE=${run}/forbidden.map" "-DDUMPBIN=${dumpbin}" "-DREPORT=${run}/forbidden.audit.txt"
    -P "${ROOT}/cmake/check_native_output.cmake" RESULT_VARIABLE rejected ERROR_VARIABLE rejection)
if(rejected EQUAL 0 OR NOT rejection MATCHES "forbidden runtime dependency" OR EXISTS "${run}/forbidden.audit.txt")
    message(FATAL_ERROR "Native output dependency gate accepted diagnostic runtime linkage: ${rejection}")
endif()
file(REMOVE "${run}/fixture.elf")
execute_process(COMMAND "${executable}" "${run}/project/program.data" --capture-stop "${run}/observation"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT result EQUAL 3 OR NOT out MATCHES "stop=1 pc=0x0000102c executed=17 v0=43")
    message(FATAL_ERROR "Compiled EE ELF execution differs: ${out} ${err}")
endif()
file(READ "${run}/observation/capture.txt" observation)
file(READ "${run}/observation/cpu.txt" cpu)
file(SIZE "${run}/observation/ram.bin" ram_size)
file(SIZE "${run}/observation/scratchpad.bin" scratchpad_size)
if(NOT observation MATCHES "complete=true" OR NOT observation MATCHES "resumable=false" OR
   NOT cpu MATCHES "pc=4140" OR NOT cpu MATCHES "gpr2=43,0" OR
   NOT ram_size EQUAL 33554432 OR NOT scratchpad_size EQUAL 16384)
    message(FATAL_ERROR "Native stop observation differs from executed fixture")
endif()
file(SHA256 "${run}/observation/cpu.txt" before_capture)
execute_process(COMMAND "${executable}" "${run}/project/program.data" --capture-stop "${run}/observation"
    RESULT_VARIABLE result ERROR_VARIABLE err TIMEOUT 10)
file(SHA256 "${run}/observation/cpu.txt" after_capture)
if(NOT result EQUAL 1 OR NOT err MATCHES "already exists" OR NOT before_capture STREQUAL after_capture)
    message(FATAL_ERROR "Existing native observation was not preserved")
endif()
execute_process(COMMAND "${executable}" "${run}/project/program.data" 1
    RESULT_VARIABLE result OUTPUT_VARIABLE out TIMEOUT 10)
if(NOT result EQUAL 4 OR NOT out MATCHES "executed=1")
    message(FATAL_ERROR "EE operation budget was ignored: ${out}")
endif()
file(WRITE "${run}/truncated.data" "short")
execute_process(COMMAND "${executable}" "${run}/truncated.data" RESULT_VARIABLE result ERROR_VARIABLE err TIMEOUT 10)
if(NOT result EQUAL 1 OR NOT err MATCHES "data mismatch")
    message(FATAL_ERROR "EE executable accepted mismatched data")
endif()

checked("${CONVERTER}" "${run}/fixture.elf.startup" "${run}/startup")
checked("${CMAKE_COMMAND}" -S "${run}/startup" -B "${run}/startup-build" -G "${GENERATOR}"
    ${platform} "-DANYPS2_ROOT=${ROOT}")
checked("${CMAKE_COMMAND}" --build "${run}/startup-build" --config Release --target ps2-native --parallel 2)
execute_process(COMMAND "${run}/startup-build/Release/ps2-native${EXE_SUFFIX}" "${run}/startup/program.data"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT result EQUAL 3 OR NOT out MATCHES "stop=1 pc=0x00001040 executed=16 v0=16384 syscall=127")
    message(FATAL_ERROR "Compiled startup service continuation differs: ${out} ${err}")
endif()

checked("${CONVERTER}" "${run}/fixture.elf.lifecycle" "${run}/lifecycle")
checked("${CMAKE_COMMAND}" -S "${run}/lifecycle" -B "${run}/lifecycle-build" -G "${GENERATOR}"
    ${platform} "-DANYPS2_ROOT=${ROOT}")
checked("${CMAKE_COMMAND}" --build "${run}/lifecycle-build" --config Release --target ps2-native --parallel 2)
execute_process(COMMAND "${run}/lifecycle-build/Release/ps2-native${EXE_SUFFIX}" "${run}/lifecycle/program.data"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT result EQUAL 3 OR NOT out MATCHES "stop=1 pc=0x00001038 executed=23 v0=50")
    message(FATAL_ERROR "Compiled lifecycle callback differs: ${out} ${err}")
endif()

checked("${CONVERTER}" "${run}/fixture.elf.table" "${run}/table")
checked("${CMAKE_COMMAND}" -S "${run}/table" -B "${run}/table-build" -G "${GENERATOR}"
    ${platform} "-DANYPS2_ROOT=${ROOT}")
checked("${CMAKE_COMMAND}" --build "${run}/table-build" --config Release --target ps2-native --parallel 2)
execute_process(COMMAND "${run}/table-build/Release/ps2-native${EXE_SUFFIX}" "${run}/table/program.data"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT result EQUAL 3 OR NOT out MATCHES "stop=1 pc=0x00001024 executed=12 v0=43")
    message(FATAL_ERROR "Compiled object-table indirect call differs: ${out} ${err}")
endif()

checked("${CONVERTER}" "${run}/fixture.elf.switch" "${run}/switch")
checked("${CMAKE_COMMAND}" -S "${run}/switch" -B "${run}/switch-build" -G "${GENERATOR}"
    ${platform} "-DANYPS2_ROOT=${ROOT}")
checked("${CMAKE_COMMAND}" --build "${run}/switch-build" --config Release --target ps2-native --parallel 2)
execute_process(COMMAND "${run}/switch-build/Release/ps2-native${EXE_SUFFIX}" "${run}/switch/program.data"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT result EQUAL 3 OR NOT out MATCHES "stop=1 pc=0x00001054 executed=11 v0=44")
    message(FATAL_ERROR "Compiled indexed switch differs: ${out} ${err}")
endif()

checked("${CONVERTER}" "${run}/fixture.elf.thread-root" "${run}/thread-root")
checked("${CMAKE_COMMAND}" -S "${run}/thread-root" -B "${run}/thread-root-build" -G "${GENERATOR}"
    ${platform} "-DANYPS2_ROOT=${ROOT}")
checked("${CMAKE_COMMAND}" --build "${run}/thread-root-build" --config Release --target ps2-native --parallel 2)
execute_process(COMMAND "${run}/thread-root-build/Release/ps2-native${EXE_SUFFIX}" "${run}/thread-root/program.data"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT result EQUAL 3 OR NOT out MATCHES "stop=1 pc=0x00001078 executed=19 v0=77")
    message(FATAL_ERROR "Compiled thread return continuation differs: ${out} ${err}")
endif()

foreach(wake sleep iwake)
    if(wake STREQUAL "sleep")
        set(expected_wakeup_result 77)
    else()
        set(expected_wakeup_result 78)
    endif()
    checked("${CONVERTER}" "${run}/fixture.elf.${wake}" "${run}/${wake}")
    checked("${CMAKE_COMMAND}" -S "${run}/${wake}" -B "${run}/${wake}-build" -G "${GENERATOR}"
        ${platform} "-DANYPS2_ROOT=${ROOT}")
    checked("${CMAKE_COMMAND}" --build "${run}/${wake}-build" --config Release --target ps2-native --parallel 2)
    execute_process(COMMAND "${run}/${wake}-build/Release/ps2-native${EXE_SUFFIX}" "${run}/${wake}/program.data"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
    if(NOT result EQUAL 3 OR NOT out MATCHES "stop=1 pc=0x0000104c executed=[0-9]+ v0=${expected_wakeup_result}")
        message(FATAL_ERROR "Compiled sleep/wakeup thread handoff differs: ${out} ${err}")
    endif()
endforeach()
