cmake_minimum_required(VERSION 3.24)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(run "${SCRATCH}/${run_id}")
file(MAKE_DIRECTORY "${run}")
function(checked)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 90)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Pointer-flow pipeline failed (${status}): ${out} ${err}")
    endif()
endfunction()
checked("${FIXTURE}" "${run}/fixture.ll" "${run}/fixture.elf")
execute_process(COMMAND "${CONVERTER}" "${run}/fixture.elf.pointer-flow-unsupported" "${run}/unsupported"
    RESULT_VARIABLE rejected ERROR_VARIABLE diagnostic)
if(NOT rejected EQUAL 1 OR EXISTS "${run}/unsupported" OR NOT diagnostic MATCHES "unsupported|Unsupported")
    message(FATAL_ERROR "Unsupported operation reached through a jump was not rejected: ${diagnostic}")
endif()
checked("${CONVERTER}" "${run}/fixture.elf.registered-indexed-callback" "${run}/registration")
file(READ "${run}/registration/pointer-references.tsv" pointers)
if(NOT pointers MATCHES "0x000010e0[^\n]*indirect-call-consumer" OR
   NOT pointers MATCHES "0x000010d0[^\n]*unclassified[^\n]*not-established-as-EE-code")
    message(FATAL_ERROR "Registration helper mixed callback and context arguments: ${pointers}")
endif()
checked("${CONVERTER}" "${run}/fixture.elf.pointer-flow" "${run}/project")
file(READ "${run}/project/pointer-references.tsv" pointers)
foreach(target 00001080 00001090)
    if(NOT pointers MATCHES "0x${target}[^\n]*discovered-EE-code")
        message(FATAL_ERROR "Compiled callback missing from pointer report: ${pointers}")
    endif()
endforeach()
if(NOT pointers MATCHES "0x000010a0[^\n]*unclassified[^\n]*not-established-as-EE-code")
    message(FATAL_ERROR "Uncalled payload is absent or misclassified: ${pointers}")
endif()
file(READ "${run}/project/call-sites.tsv" calls)
if(NOT calls MATCHES "unresolved-indirect")
    message(FATAL_ERROR "Unresolved runtime target is not reported: ${calls}")
endif()
set(platform)
if(PLATFORM)
    list(APPEND platform -A "${PLATFORM}")
endif()
checked("${CMAKE_COMMAND}" -S "${run}/project" -B "${run}/build" -G "${GENERATOR}" ${platform} "-DANYPS2_ROOT=${ROOT}")
checked("${CMAKE_COMMAND}" --build "${run}/build" --config Release --target ps2-native --parallel 2)
set(exe "${run}/build/Release/ps2-native${EXE_SUFFIX}")
execute_process(COMMAND "${exe}" "${run}/project/program.data" --headless
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT status EQUAL 3 OR NOT out MATCHES "stop=2 pc=0x00003000 executed=[0-9]+ v0=22")
    message(FATAL_ERROR "Mutable native callback execution differs: ${out} ${err}")
endif()
file(READ "${exe}.audit.txt" audit)
if(NOT audit MATCHES "dependency audit passed")
    message(FATAL_ERROR "Native dependency audit missing")
endif()
checked("${CONVERTER}" "${run}/fixture.elf.indexed-callback" "${run}/table")
file(READ "${run}/table/pointer-references.tsv" pointers)
if(NOT pointers MATCHES "0x000010e0[^\n]*indirect-call-consumer" OR
   NOT pointers MATCHES "0x000010d0[^\n]*unclassified[^\n]*not-established-as-EE-code")
    message(FATAL_ERROR "Indexed table mixed callback and context fields: ${pointers}")
endif()
checked("${CMAKE_COMMAND}" -S "${run}/table" -B "${run}/table-build" -G "${GENERATOR}" ${platform} "-DANYPS2_ROOT=${ROOT}")
checked("${CMAKE_COMMAND}" --build "${run}/table-build" --config Release --target ps2-native --parallel 2)
execute_process(COMMAND "${run}/table-build/Release/ps2-native${EXE_SUFFIX}" "${run}/table/program.data" --headless
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT status EQUAL 3 OR NOT out MATCHES "stop=1 pc=0x00001040 executed=[0-9]+ v0=42")
    message(FATAL_ERROR "Initialized indexed callback table did not execute: ${out} ${err}")
endif()
checked("${CMAKE_COMMAND}" -S "${run}/registration" -B "${run}/registration-build" -G "${GENERATOR}" ${platform} "-DANYPS2_ROOT=${ROOT}")
checked("${CMAKE_COMMAND}" --build "${run}/registration-build" --config Release --target ps2-native --parallel 2)
execute_process(COMMAND "${run}/registration-build/Release/ps2-native${EXE_SUFFIX}" "${run}/registration/program.data" --headless
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT status EQUAL 3 OR NOT out MATCHES "stop=1 pc=0x00001038 executed=[0-9]+ v0=42")
    message(FATAL_ERROR "Registered indexed callback did not execute: ${out} ${err}")
endif()
checked("${CONVERTER}" "${run}/fixture.elf.nested-callback-unrelated" "${run}/unrelated")
file(READ "${run}/unrelated/pointer-references.tsv" pointers)
if(pointers MATCHES "0x000010e0[^\n]*indirect-call-consumer")
    message(FATAL_ERROR "Unrelated nested field became a callback: ${pointers}")
endif()
checked("${CONVERTER}" "${run}/fixture.elf.nested-callback" "${run}/nested")
file(READ "${run}/nested/pointer-references.tsv" pointers)
if(NOT pointers MATCHES "0x000010e0[^\n]*indirect-call-consumer" OR
   NOT pointers MATCHES "0x000010d0[^\n]*unclassified[^\n]*not-established-as-EE-code")
    message(FATAL_ERROR "Nested callback registration misclassified arguments: ${pointers}")
endif()
checked("${CMAKE_COMMAND}" -S "${run}/nested" -B "${run}/nested-build" -G "${GENERATOR}" ${platform} "-DANYPS2_ROOT=${ROOT}")
checked("${CMAKE_COMMAND}" --build "${run}/nested-build" --config Release --target ps2-native --parallel 2)
execute_process(COMMAND "${run}/nested-build/Release/ps2-native${EXE_SUFFIX}" "${run}/nested/program.data" --headless
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT status EQUAL 3 OR NOT out MATCHES "stop=1 pc=0x00001028 executed=[0-9]+ v0=42")
    message(FATAL_ERROR "Nested callback did not execute: ${out} ${err}")
endif()
checked("${CONVERTER}" "${run}/fixture.elf.referenced-stack-unrelated" "${run}/reference-unrelated")
file(READ "${run}/reference-unrelated/pointer-references.tsv" pointers)
if(pointers MATCHES "0x000010e0[^\n]*indirect-call-consumer")
    message(FATAL_ERROR "Unrelated reference setter became a bound callback: ${pointers}")
endif()
checked("${CONVERTER}" "${run}/fixture.elf.referenced-stack-callback" "${run}/reference")
file(READ "${run}/reference/pointer-references.tsv" pointers)
if(NOT pointers MATCHES "0x000010e0[^\n]*indirect-call-consumer")
    message(FATAL_ERROR "Referenced stack callback was not discovered: ${pointers}")
endif()
checked("${CMAKE_COMMAND}" -S "${run}/reference" -B "${run}/reference-build" -G "${GENERATOR}" ${platform} "-DANYPS2_ROOT=${ROOT}")
checked("${CMAKE_COMMAND}" --build "${run}/reference-build" --config Release --target ps2-native --parallel 2)
execute_process(COMMAND "${run}/reference-build/Release/ps2-native${EXE_SUFFIX}" "${run}/reference/program.data" --headless
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT status EQUAL 3 OR NOT out MATCHES "stop=1 pc=0x00001034 executed=[0-9]+ v0=42")
    message(FATAL_ERROR "Referenced stack callback did not execute: ${out} ${err}")
endif()
foreach(kind overwritten cleared)
    checked("${CONVERTER}" "${run}/fixture.elf.frame-thread-${kind}" "${run}/thread-${kind}")
    file(READ "${run}/thread-${kind}/pointer-references.tsv" pointers)
    if(pointers MATCHES "0x000011c0[^\n]*discovered-EE-code")
        message(FATAL_ERROR "Overwritten thread entry was resurrected: ${pointers}")
    endif()
endforeach()
checked("${CONVERTER}" "${run}/fixture.elf.copied-record-unrelated" "${run}/record-unrelated")
file(READ "${run}/record-unrelated/pointer-references.tsv" pointers)
if(pointers MATCHES "0x000010e0[^\n]*discovered-EE-code")
    message(FATAL_ERROR "Unrelated copied record became callable: ${pointers}")
endif()
foreach(kind partial source unrelated overwritten word-overwritten)
    checked("${CONVERTER}" "${run}/fixture.elf.inline-record-${kind}" "${run}/inline-${kind}")
    file(READ "${run}/inline-${kind}/pointer-references.tsv" pointers)
    if(pointers MATCHES "0x000010e0[^\n]*discovered-EE-code")
        message(FATAL_ERROR "Incomplete or unrelated inline copy became callable: ${pointers}")
    endif()
endforeach()
foreach(kind copied-callback-record copied-aligned-record inline-callback-record inline-aligned-record)
    checked("${CONVERTER}" "${run}/fixture.elf.${kind}" "${run}/${kind}")
    file(READ "${run}/${kind}/pointer-references.tsv" pointers)
    if(NOT pointers MATCHES "0x000010d0[^\n]*not-established-as-EE-code")
        message(FATAL_ERROR "Copied opaque context was not kept as data: ${pointers}")
    endif()
    checked("${CMAKE_COMMAND}" -S "${run}/${kind}" -B "${run}/${kind}-build" -G "${GENERATOR}" ${platform} "-DANYPS2_ROOT=${ROOT}")
    checked("${CMAKE_COMMAND}" --build "${run}/${kind}-build" --config Release --target ps2-native --parallel 2)
    execute_process(COMMAND "${run}/${kind}-build/Release/ps2-native${EXE_SUFFIX}" "${run}/${kind}/program.data" --headless
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
    if(NOT status EQUAL 3 OR NOT out MATCHES "stop=1 pc=0x00001010 executed=[0-9]+ v0=42")
        message(FATAL_ERROR "Copied callback record did not execute: ${out} ${err}")
    endif()
endforeach()
checked("${CONVERTER}" "${run}/fixture.elf.frame-thread" "${run}/thread")
checked("${CMAKE_COMMAND}" -S "${run}/thread" -B "${run}/thread-build" -G "${GENERATOR}" ${platform} "-DANYPS2_ROOT=${ROOT}")
checked("${CMAKE_COMMAND}" --build "${run}/thread-build" --config Release --target ps2-native --parallel 2)
execute_process(COMMAND "${run}/thread-build/Release/ps2-native${EXE_SUFFIX}" "${run}/thread/program.data" --headless
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT status EQUAL 3 OR NOT out MATCHES "stop=1 pc=0x000011c8 executed=[0-9]+ v0=42")
    message(FATAL_ERROR "Saved-frame thread entry did not execute: ${out} ${err}")
endif()
checked("${CONVERTER}" "${run}/fixture.elf.countdown-unproved" "${run}/countdown-unproved")
file(READ "${run}/countdown-unproved/pointer-references.tsv" pointers)
if(pointers MATCHES "0x000010e0[^\n]*discovered-EE-code")
    message(FATAL_ERROR "Inconsistent loop paths produced a callback-table bound: ${pointers}")
endif()
checked("${CONVERTER}" "${run}/fixture.elf.countdown-callbacks" "${run}/countdown")
checked("${CMAKE_COMMAND}" -S "${run}/countdown" -B "${run}/countdown-build" -G "${GENERATOR}" ${platform} "-DANYPS2_ROOT=${ROOT}")
checked("${CMAKE_COMMAND}" --build "${run}/countdown-build" --config Release --target ps2-native --parallel 2)
execute_process(COMMAND "${run}/countdown-build/Release/ps2-native${EXE_SUFFIX}" "${run}/countdown/program.data" --headless
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT status EQUAL 3 OR NOT out MATCHES "stop=1 pc=0x0000102c executed=[0-9]+ v0=42")
    message(FATAL_ERROR "Counted callback table did not execute both callbacks: ${out} ${err}")
endif()
foreach(kind overwritten cleared alias-overwritten unrelated callee-cleared unrelated-context)
    checked("${CONVERTER}" "${run}/fixture.elf.object-field-${kind}" "${run}/object-${kind}")
    file(READ "${run}/object-${kind}/pointer-references.tsv" pointers)
    if(pointers MATCHES "0x00001200[^\n]*discovered-EE-code")
        message(FATAL_ERROR "Invalid object-field registration became executable: ${pointers}")
    endif()
endforeach()
checked("${CONVERTER}" "${run}/fixture.elf.object-field-loaded-before-clear" "${run}/object-loaded")
file(READ "${run}/object-loaded/pointer-references.tsv" loaded_pointers)
if(NOT loaded_pointers MATCHES "0x00001200[^\n]*discovered-EE-code")
    message(FATAL_ERROR "A later field write invalidated an already loaded callback: ${loaded_pointers}")
endif()
checked("${CONVERTER}" "${run}/fixture.elf.object-argument-unrelated" "${run}/object-argument-unrelated")
file(READ "${run}/object-argument-unrelated/pointer-references.tsv" pointers)
if(pointers MATCHES "0x00001200[^\n]*discovered-EE-code")
    message(FATAL_ERROR "Mismatched context established an argument callback: ${pointers}")
endif()
foreach(kind field argument)
    set(object "${run}/object-${kind}")
    checked("${CONVERTER}" "${run}/fixture.elf.object-${kind}-registration" "${object}")
    file(READ "${object}/pointer-references.tsv" pointers)
    if(NOT pointers MATCHES "0x00001210[^\n]*not-established-as-EE-code")
        message(FATAL_ERROR "Adjacent object payload became executable: ${pointers}")
    endif()
    checked("${CMAKE_COMMAND}" -S "${object}" -B "${object}-build" -G "${GENERATOR}" ${platform} "-DANYPS2_ROOT=${ROOT}")
    checked("${CMAKE_COMMAND}" --build "${object}-build" --config Release --target ps2-native --parallel 2)
    execute_process(COMMAND "${object}-build/Release/ps2-native${EXE_SUFFIX}" "${object}/program.data" --headless
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
    if(NOT status EQUAL 3 OR NOT out MATCHES "stop=1 pc=0x00001028 executed=[0-9]+ v0=42")
        message(FATAL_ERROR "Object callback registration did not execute: ${out} ${err}")
    endif()
endforeach()
foreach(kind unrelated context overwritten base-reused disjoint)
    checked("${CONVERTER}" "${run}/fixture.elf.gp-record-${kind}" "${run}/gp-${kind}")
    file(READ "${run}/gp-${kind}/pointer-references.tsv" pointers)
    if(pointers MATCHES "0x00001200[^\n]*discovered-EE-code")
        message(FATAL_ERROR "Invalid saved-GP record became executable: ${pointers}")
    endif()
endforeach()
foreach(kind unrelated field overwritten annulled)
    checked("${CONVERTER}" "${run}/fixture.elf.registered-context-${kind}" "${run}/context-${kind}")
    file(READ "${run}/context-${kind}/pointer-references.tsv" pointers)
    if(pointers MATCHES "0x00001230[^\n]*discovered-EE-code")
        message(FATAL_ERROR "Unproven registered context field became executable: ${pointers}")
    endif()
endforeach()
foreach(kind gp-callback-record registered-context-callback)
    set(callback "${run}/${kind}")
    checked("${CONVERTER}" "${run}/fixture.elf.${kind}" "${callback}")
    file(READ "${callback}/pointer-references.tsv" pointers)
    if(NOT pointers MATCHES "0x00001210[^\n]*not-established-as-EE-code")
        message(FATAL_ERROR "Registered callback payload became executable: ${pointers}")
    endif()
    checked("${CMAKE_COMMAND}" -S "${callback}" -B "${callback}-build" -G "${GENERATOR}" ${platform} "-DANYPS2_ROOT=${ROOT}")
    checked("${CMAKE_COMMAND}" --build "${callback}-build" --config Release --target ps2-native --parallel 2)
    execute_process(COMMAND "${callback}-build/Release/ps2-native${EXE_SUFFIX}" "${callback}/program.data" --headless
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
    if(NOT status EQUAL 3 OR NOT out MATCHES "stop=1 pc=0x0000103c executed=[0-9]+ v0=48")
        message(FATAL_ERROR "Registered callback did not use the saved GP and context: ${out} ${err}")
    endif()
endforeach()
