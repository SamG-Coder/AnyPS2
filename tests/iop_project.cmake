cmake_minimum_required(VERSION 3.24)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(run "${SCRATCH}/${run_id}")
file(MAKE_DIRECTORY "${run}")
function(checked)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 90)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "IOP conversion pipeline failed (${result}): ${out}\n${err}")
    endif()
endfunction()
checked("${FIXTURE}" "${run}/fixture.ll" "${run}/fixture.irx")
execute_process(COMMAND "${CONVERTER}" "${run}/fixture.irx" "${run}/cpp-rejected" 0x1000 --cpp
    RESULT_VARIABLE rejected ERROR_VARIABLE diagnostic)
if(NOT rejected EQUAL 1 OR EXISTS "${run}/cpp-rejected")
    message(FATAL_ERROR "Removed C++ backend was accepted or left output behind")
endif()
checked("${CONVERTER}" "${run}/fixture.irx" "${run}/project" 0x1000)
checked("${CONVERTER}" --bundle "${run}/bundle" 0x1000 "${run}/fixture.irx" 0x3000 "${run}/fixture.irx.client.irx" 0x5000 "${run}/fixture.irx.disc.irx" romdrv@7000 "${run}/fixture.irx.romdrv.irx")
execute_process(COMMAND "${CONVERTER}" --bundle "${run}/bad-replacement" romdrv@1000 "${run}/fixture.irx"
    RESULT_VARIABLE rejected ERROR_VARIABLE diagnostic)
if(NOT rejected EQUAL 1 OR EXISTS "${run}/bad-replacement")
    message(FATAL_ERROR "Native replacement accepted an incompatible library ABI")
endif()
execute_process(COMMAND "${CONVERTER}" --bundle "${run}/overlap" 0x1000 "${run}/fixture.irx" 0x1000 "${run}/fixture.irx.client.irx"
    RESULT_VARIABLE rejected ERROR_VARIABLE diagnostic)
if(NOT rejected EQUAL 1 OR EXISTS "${run}/overlap" OR NOT diagnostic MATCHES "overlapping bundle modules")
    message(FATAL_ERROR "Overlapping bundle was accepted or left output behind")
endif()
execute_process(COMMAND "${CONVERTER}" --bundle "${run}/missing" 0x3000 "${run}/fixture.irx.client.irx"
    RESULT_VARIABLE rejected ERROR_VARIABLE diagnostic)
if(NOT rejected EQUAL 1 OR EXISTS "${run}/missing" OR NOT diagnostic MATCHES "unsupported native imports")
    message(FATAL_ERROR "Bundle missing its provider was accepted or left output behind")
endif()
file(READ "${run}/bundle/module_metadata.cpp" bundle_meta)
if(NOT bundle_meta MATCHES "std::vector<nt::iop::SealedModule> nt_iop_generated_sealed\\(\\) \\{ return \\{\\}; \\}")
    message(FATAL_ERROR "romdrv@ bundle did not emit an empty sealed vector")
endif()
if(EXISTS "${run}/bundle/sealed.data")
    message(FATAL_ERROR "romdrv@ bundle wrote a sealed image")
endif()
checked("${CONVERTER}" --bundle "${run}/sealed" 0x3000 "${run}/fixture.irx.client.irx" sealed@1000 "${run}/fixture.irx")
file(READ "${run}/sealed/module_metadata.cpp" sealed_meta)
file(READ "${run}/sealed/modules.txt" sealed_layout)
if(NOT sealed_meta MATCHES "std::vector<nt::iop::SealedModule> nt_iop_generated_sealed\\(\\)")
    message(FATAL_ERROR "Sealed conversion did not emit nt_iop_generated_sealed")
endif()
string(REGEX MATCH "nt_iop_generated_sealed\\(\\) \\{ return \\{[ \t\r\n]*\\{([0-9]+)ULL,([0-9]+)ULL,4096U,4096U,416U,448U,0U\\}" sealed_record "${sealed_meta}")
if(NOT sealed_record)
    message(FATAL_ERROR "Sealed record does not describe the relocated fixture")
endif()
set(sealed_source "${CMAKE_MATCH_1}")
string(REGEX MATCH "nt_iop_generated_source_hashes\\(\\) \\{ return \\{([^}]*)\\}" startup_hashes "${sealed_meta}")
if(NOT startup_hashes OR CMAKE_MATCH_1 MATCHES "${sealed_source}ULL")
    message(FATAL_ERROR "Sealed source hash was listed in the startup catalog")
endif()
string(REGEX MATCH "nt_iop_generated_entries\\(\\) \\{ return \\{([^;]*)" startup_entries "${sealed_meta}")
if(NOT startup_entries OR CMAKE_MATCH_1 MATCHES "4096U")
    message(FATAL_ERROR "Sealed module was emitted as a startup entry")
endif()
if(sealed_meta MATCHES "native_replacement" OR sealed_meta MATCHES "NativeModuleKind::archive")
    message(FATAL_ERROR "A non-ROMDRV export name set native replacement")
endif()
if(NOT sealed_layout MATCHES "0x00001000 0x00001000 0x000001c0 sealed" OR sealed_layout MATCHES "native-ROMDRV-archive" OR sealed_layout MATCHES "0x00001000 0x00001000 0x000001c0 LLVM")
    message(FATAL_ERROR "Sealed module was recorded as a startup LLVM or ROMDRV entry")
endif()
file(READ "${run}/fixture.irx" irx_hex HEX)
string(SUBSTRING "${irx_hex}" 256 832 relocated_hex)
file(READ "${run}/sealed/sealed.data" sealed_hex HEX)
if(NOT sealed_hex STREQUAL relocated_hex)
    message(FATAL_ERROR "sealed.data does not match the relocated initialized bytes")
endif()
file(READ "${run}/sealed/module_metadata.cpp" sealed_meta_hex HEX)
string(FIND "${sealed_meta_hex}" "${relocated_hex}" metadata_has_image)
if(NOT metadata_has_image EQUAL -1)
    message(FATAL_ERROR "module_metadata.cpp contains sealed image bytes")
endif()
file(SIZE "${run}/sealed/module.data" startup_bytes)
if(NOT startup_bytes EQUAL 128)
    message(FATAL_ERROR "Sealed module was copied into the startup image")
endif()
execute_process(COMMAND "${CONVERTER}" --bundle "${run}/sealed-unaligned" sealed@1010 "${run}/fixture.irx"
    RESULT_VARIABLE rejected ERROR_VARIABLE diagnostic)
if(NOT rejected EQUAL 1 OR EXISTS "${run}/sealed-unaligned" OR NOT diagnostic MATCHES "256")
    message(FATAL_ERROR "Unaligned sealed base was accepted or left output behind: ${diagnostic}")
endif()
execute_process(COMMAND "${CONVERTER}" --bundle "${run}/sealed-overlap" 0x1000 "${run}/fixture.irx" sealed@1000 "${run}/fixture.irx"
    RESULT_VARIABLE rejected ERROR_VARIABLE diagnostic)
if(NOT rejected EQUAL 1 OR EXISTS "${run}/sealed-overlap" OR NOT diagnostic MATCHES "overlapping bundle modules")
    message(FATAL_ERROR "Overlapping sealed base was accepted or left output behind: ${diagnostic}")
endif()
execute_process(COMMAND "${CONVERTER}" --bundle "${run}/sealed-gap" 0x1000 "${run}/fixture.irx" 0x3000 "${run}/fixture.irx.client.irx" sealed@2000 "${run}/fixture.irx"
    RESULT_VARIABLE rejected ERROR_VARIABLE diagnostic)
if(NOT rejected EQUAL 1 OR EXISTS "${run}/sealed-gap" OR NOT diagnostic MATCHES "startup image")
    message(FATAL_ERROR "Sealed module inside the startup image was accepted: ${diagnostic}")
endif()
execute_process(COMMAND "${CONVERTER}" --bundle "${run}/sealed-romdrv" sealed@romdrv@1000 "${run}/fixture.irx.romdrv.irx"
    RESULT_VARIABLE rejected ERROR_VARIABLE diagnostic)
if(NOT rejected EQUAL 1 OR EXISTS "${run}/sealed-romdrv" OR NOT diagnostic MATCHES "sealed@")
    message(FATAL_ERROR "sealed@romdrv@ was accepted or left output behind: ${diagnostic}")
endif()
file(READ "${run}/project/CMakeLists.txt" project)
string(REPLACE "target_link_libraries(iop-native PRIVATE nt_audio nt_usb)" "" checked_project "${project}")
if(checked_project MATCHES "target_link_libraries|add_subdirectory|find_package|iop_cpu|cpu\\.cpp")
    message(FATAL_ERROR "Standalone output introduced runtime library dependencies")
endif()
file(READ "${run}/project/generated.ll" generated)
if(NOT generated MATCHES "define i32 @nt_iop_llvm_run_v2")
    message(FATAL_ERROR "LLVM conversion did not emit the native entry")
endif()
if(generated MATCHES "nt::iop::run|iop_cpu\\.hpp")
    message(FATAL_ERROR "Standalone output contains an interpreter entry point")
endif()
set(platform)
if(PLATFORM)
    list(APPEND platform -A "${PLATFORM}")
endif()
checked("${CMAKE_COMMAND}" -S "${run}/project" -B "${run}/build" -G "${GENERATOR}"
    ${platform} "-DANYPS2_ROOT=${ROOT}" -DCMAKE_BUILD_TYPE=Release)
checked("${CMAKE_COMMAND}" --build "${run}/build" --config Release --target iop-native --parallel 2)
set(executable "${run}/build/iop-native${EXE_SUFFIX}")
if(EXISTS "${run}/build/Release/iop-native${EXE_SUFFIX}")
    set(executable "${run}/build/Release/iop-native${EXE_SUFFIX}")
endif()
# Remove only this test's original IRX: compiled output must not need it.
file(REMOVE "${run}/fixture.irx" "${run}/fixture.irx.client.irx" "${run}/fixture.irx.disc.irx")
execute_process(COMMAND "${executable}" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT result EQUAL 0 OR NOT out MATCHES "returned=43 executed=31")
    message(FATAL_ERROR "Compiled module did not return expected result: ${out} ${err}")
endif()
file(WRITE "${run}/truncated.data" "short")
execute_process(COMMAND "${executable}" "${run}/truncated.data" RESULT_VARIABLE result ERROR_VARIABLE err TIMEOUT 10)
if(NOT result EQUAL 1 OR NOT err MATCHES "Module data size mismatch")
    message(FATAL_ERROR "Converted executable accepted mismatched initialized data")
endif()

# A separate generated executable owns both modules and preserves provider registration.
checked("${CMAKE_COMMAND}" -S "${run}/bundle" -B "${run}/bb" -G "${GENERATOR}"
    ${platform} "-DANYPS2_ROOT=${ROOT}" -DCMAKE_BUILD_TYPE=Release)
checked("${CMAKE_COMMAND}" --build "${run}/bb" --config Release --target iop-native --parallel 2)
set(bundle_executable "${run}/bb/iop-native${EXE_SUFFIX}")
if(EXISTS "${run}/bb/Release/iop-native${EXE_SUFFIX}")
    set(bundle_executable "${run}/bb/Release/iop-native${EXE_SUFFIX}")
endif()
execute_process(COMMAND "${bundle_executable}" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT result EQUAL 3 OR NOT err MATCHES "module=2 reason=9")
    message(FATAL_ERROR "Disc import did not stop explicitly without a mounted image: ${out} ${err}")
endif()
execute_process(COMMAND "${bundle_executable}" --disc "${run}/fixture.irx.iso" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT result EQUAL 0 OR NOT out MATCHES "module=0 returned=43 executed=31" OR NOT out MATCHES "module=1 returned=43 executed=11" OR NOT out MATCHES "module=2 returned=43 executed=23" OR NOT out MATCHES "module=3 returned=0 executed=0")
    message(FATAL_ERROR "Compiled bundle did not preserve startup order and native linking: ${out} ${err}")
endif()

# Compose separately generated EE and IOP LLVM objects in the shipped host.
# No reset occurs in this fixture: merely supplying a bundle must not start it.
checked("${EEFIXTURE}" "${run}/ee.ll" "${run}/ee.elf")
checked("${EECONVERTER}" "${run}/ee.elf" "${run}/ee-project")
checked("${CMAKE_COMMAND}" -S "${run}/ee-project" -B "${run}/lb" -G "${GENERATOR}"
    ${platform} "-DANYPS2_ROOT=${ROOT}" "-DANYPS2_IOP_PROJECT=${run}/project")
checked("${CMAKE_COMMAND}" --build "${run}/lb" --config Release --target ps2-native --parallel 2)
set(linked "${run}/lb/Release/ps2-native${EXE_SUFFIX}")
execute_process(COMMAND "${linked}" "${run}/ee-project/program.data" --headless --probe-iop-reset "${run}/project/module.data"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT result EQUAL 3 OR NOT out MATCHES "stop=1 pc=0x0000102c executed=17 v0=43" OR out MATCHES "iop_reset_accepted")
    message(FATAL_ERROR "Linked IOP probe changed EE startup without reset: ${out} ${err}")
endif()
execute_process(COMMAND "${linked}" "${run}/ee-project/program.data" --headless --iop-reset-session "${run}/project/module.data"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT result EQUAL 3 OR NOT out MATCHES "stop=1 pc=0x0000102c executed=17 v0=43" OR out MATCHES "iop_reset_accepted")
    message(FATAL_ERROR "Linked session ran before an EE reset request: ${out} ${err}")
endif()
file(WRITE "${run}/invalid-iop.data" "invalid")
execute_process(COMMAND "${linked}" "${run}/ee-project/program.data" --headless --probe-iop-reset "${run}/invalid-iop.data"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT result EQUAL 1 OR NOT err MATCHES "Invalid linked IOP startup data")
    message(FATAL_ERROR "Linked IOP probe accepted mismatched data: ${out} ${err}")
endif()
