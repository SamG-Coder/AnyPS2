cmake_minimum_required(VERSION 3.24)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(run "${SCRATCH}/${id}")
file(MAKE_DIRECTORY "${run}")
function(checked)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Command failed: ${ARGV}\n${out}\n${err}")
    endif()
endfunction()
if(PLATFORM)
    set(platform -A "${PLATFORM}")
endif()
checked("${FIXTURE}" "${run}/fixture.ll" "${run}/fixture.elf")
foreach(kind object-callbacks object-callbacks-mutable copied-callbacks scaled-callbacks long-frame-callbacks)
    set(project "${run}/${kind}")
    checked("${CONVERTER}" "${run}/fixture.elf.${kind}" "${project}")
    file(READ "${project}/pointer-references.tsv" pointers)
    if(kind STREQUAL "copied-callbacks" OR kind STREQUAL "scaled-callbacks")
        if(NOT pointers MATCHES "0x00001200[^\n]*discovered-EE-code" OR
           NOT pointers MATCHES "0x00001210[^\n]*discovered-EE-code" OR
           pointers MATCHES "0x00001220[^\n]*discovered-EE-code")
            message(FATAL_ERROR "Copied descriptor lost callbacks or compiled its payload: ${pointers}")
        endif()
    elseif(kind STREQUAL "long-frame-callbacks")
        if(NOT pointers MATCHES "0x00001700[^\n]*discovered-EE-code" OR
           NOT pointers MATCHES "0x00001710[^\n]*discovered-EE-code" OR
           pointers MATCHES "0x00001720[^\n]*discovered-EE-code")
            message(FATAL_ERROR "Long frame lost callbacks or compiled its payload: ${pointers}")
        endif()
    elseif(NOT pointers MATCHES "0x00001260[^\n]*discovered-EE-code" OR
       NOT pointers MATCHES "0x00001270[^\n]*discovered-EE-code" OR
       NOT pointers MATCHES "0x00001280[^\n]*not-established-as-EE-code")
        message(FATAL_ERROR "Object initialization lost a callback or compiled opaque data: ${pointers}")
    endif()
    checked("${CMAKE_COMMAND}" -S "${project}" -B "${project}-build" -G "${GENERATOR}" ${platform} "-DANYPS2_ROOT=${ROOT}")
    checked("${CMAKE_COMMAND}" --build "${project}-build" --config Release --target ps2-native --parallel 2)
    execute_process(COMMAND "${project}-build/Release/ps2-native${EXE_SUFFIX}" "${project}/program.data" --headless
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
    set(stop_pc 00001028)
    if(kind STREQUAL "copied-callbacks")
        set(expected 42)
        set(stop_pc 00001010)
    elseif(kind STREQUAL "scaled-callbacks")
        set(expected 42)
        set(stop_pc 00001040)
    elseif(kind STREQUAL "long-frame-callbacks")
        set(expected 42)
        set(stop_pc 00001014)
    elseif(kind STREQUAL "object-callbacks")
        set(expected 42)
    else()
        set(expected 64)
    endif()
    if(NOT status EQUAL 3 OR NOT out MATCHES "stop=1 pc=0x${stop_pc} executed=[0-9]+ v0=${expected}")
        message(FATAL_ERROR "Compiled virtual callbacks did not read runtime fields: ${out} ${err}")
    endif()
endforeach()
