cmake_minimum_required(VERSION 3.24)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(run "${SCRATCH}/${id}")
file(MAKE_DIRECTORY "${run}")
function(checked)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 90)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Vector-container pipeline failed: ${out}\n${err}")
    endif()
endfunction()
checked("${FIXTURE}" "${run}/fixture.ll" "${run}/fixture.elf")
checked("${CONVERTER}" "${run}/fixture.elf.vector" "${run}/project")
set(platform)
if(PLATFORM)
    list(APPEND platform -A "${PLATFORM}")
endif()
checked("${CMAKE_COMMAND}" -S "${run}/project" -B "${run}/build" -G "${GENERATOR}"
    ${platform} "-DANYPS2_ROOT=${ROOT}")
checked("${CMAKE_COMMAND}" --build "${run}/build" --config Release --target ps2-native --parallel 2)
set(executable "${run}/build/Release/ps2-native${EXE_SUFFIX}")
execute_process(COMMAND "${executable}" "${run}/project/program.data" --headless
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT result EQUAL 3 OR NOT out MATCHES "stop=1 pc=0x00001010 executed=4 v0=305419896")
    message(FATAL_ERROR "Native EE code failed to read preserved VU storage: ${out}\n${err}")
endif()
file(READ "${executable}.audit.txt" audit)
if(NOT audit MATCHES "dependency audit passed")
    message(FATAL_ERROR "Native vector-container output failed dependency audit")
endif()
