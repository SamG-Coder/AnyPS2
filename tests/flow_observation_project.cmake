cmake_minimum_required(VERSION 3.24)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(run "${SCRATCH}/${id}")
file(MAKE_DIRECTORY "${run}")
function(checked)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 90)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Native observation pipeline failed: ${ARGV}\n${out}\n${err}")
    endif()
endfunction()
if(PLATFORM)
    set(platform -A "${PLATFORM}")
endif()
checked("${FIXTURE}" "${run}/fixture.ll" "${run}/fixture.elf")
set(input "${run}/fixture.elf.observation")
set(observations)
foreach(stage RANGE 0 2)
    set(project "${run}/project-${stage}")
    checked("${CONVERTER}" "${input}" "${project}" ${observations})
    checked("${CMAKE_COMMAND}" -S "${project}" -B "${project}-build" -G "${GENERATOR}" ${platform} "-DANYPS2_ROOT=${ROOT}")
    checked("${CMAKE_COMMAND}" --build "${project}-build" --config Release --target ps2-native --parallel 2)
    set(executable "${project}-build/Release/ps2-native${EXE_SUFFIX}")
    execute_process(COMMAND "${executable}" "${project}/program.data" --headless --capture-stop "${run}/capture-${stage}"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
    if(stage EQUAL 0)
        set(expected "stop=2 pc=0x00001100")
    elseif(stage EQUAL 1)
        set(expected "stop=2 pc=0x00001180")
    else()
        set(expected "stop=1 pc=0x0000101c executed=[0-9]+ v0=42")
    endif()
    if(NOT status EQUAL 3 OR NOT out MATCHES "${expected}")
        message(FATAL_ERROR "Native observation stage ${stage} differs: ${out} ${err}")
    endif()
    file(READ "${executable}.audit.txt" audit)
    if(NOT audit MATCHES "dependency audit passed")
        message(FATAL_ERROR "Observed callback output failed dependency audit")
    endif()
    # Reverse input order tests a source reached only through another capture.
    list(PREPEND observations --observation "${run}/capture-${stage}")
endforeach()
file(READ "${run}/project-2/observed-call-edges.tsv" edges)
if(NOT edges MATCHES "0x00001010[\t]0x00001100" OR NOT edges MATCHES "0x00001110[\t]0x00001180")
    message(FATAL_ERROR "Observed callback provenance is incomplete: ${edges}")
endif()
file(READ "${run}/project-2/call-sites.tsv" calls)
if(NOT calls MATCHES "unresolved-indirect")
    message(FATAL_ERROR "Witnessed targets incorrectly established complete dynamic coverage")
endif()
execute_process(COMMAND "${CONVERTER}" "${input}" "${run}/verified" --verify-only
    --observation "${run}/capture-1" --observation "${run}/capture-0"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
file(READ "${run}/verified/flow-verification.txt" summary)
if(NOT status EQUAL 2 OR NOT summary MATCHES "validated_observed_edges=2" OR
   NOT summary MATCHES "LLVM_emitted=0" OR NOT summary MATCHES "runtime_executed=0" OR
   EXISTS "${run}/verified/generated.ll")
    message(FATAL_ERROR "Observed-flow verification lost its coverage limits: ${out} ${err} ${summary}")
endif()
checked("${CHECKER}" "${input}" "${run}/capture-0" "${run}/rejections")
