cmake_minimum_required(VERSION 3.24)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(run "${SCRATCH}/${run_id}")
file(MAKE_DIRECTORY "${run}")
function(checked)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Automatic conversion pipeline failed (${result}): ${out}\n${err}")
    endif()
endfunction()
checked("${PACKED_FIXTURE}" "${run}/packed.bin")
checked("${FIXTURE}" --emit-fixture "${run}/Synthetic Disc.iso" "${run}/packed.bin")
# Default destination, boot role and library roles are all derived by the tool.
execute_process(COMMAND "${CONVERTER}" convert "${run}/Synthetic Disc.iso" --jobs 2
    --source-root "${ROOT}" WORKING_DIRECTORY "${run}"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Automatic build failed: ${out}\n${err}")
endif()
set(project "${run}/work/Synthetic Disc-native")
file(READ "${project}/build-plan.json" plan)
string(JSON count LENGTH "${plan}" targets)
math(EXPR last "${count}-1")
set(libraries 0)
foreach(index RANGE ${last})
    string(JSON role GET "${plan}" targets ${index} role)
    string(JSON output GET "${plan}" targets ${index} output)
    if(role STREQUAL "library")
        if(NOT EXISTS "${project}/${output}")
            message(FATAL_ERROR "Automatic library output missing: ${output}")
        endif()
        math(EXPR libraries "${libraries}+1")
    elseif(role STREQUAL "executable")
        string(JSON module GET "${plan}" targets ${index} modules 0)
        get_filename_component(data_directory "${project}/${module}" DIRECTORY)
    endif()
endforeach()
if(NOT libraries EQUAL 3 OR NOT data_directory)
    message(FATAL_ERROR "Wrong executable/library roles in the automatic plan")
endif()
set(executable "${project}/bin/ps2-native${EXE_SUFFIX}")
file(READ "${executable}.audit.txt" audit)
if(NOT audit MATCHES "dependency audit passed")
    message(FATAL_ERROR "Automatic executable is missing the native dependency audit")
endif()
execute_process(COMMAND "${executable}" "${project}/bin/program.data" 2 --headless
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT result EQUAL 4 OR NOT out MATCHES "stop=0 pc=0x00100008 executed=2 v0=43")
    message(FATAL_ERROR "Automatically linked executable did not execute native code: ${out}\n${err}")
endif()
# The build is incremental. LLVM reporting and compiler selection remain usable
# on an existing plan without regenerating the ISO or writing game C++.
checked("${CMAKE_COMMAND}" -S "${project}" -B "${project}/build" -DANYPS2_LLVM_REPORTS=ON)
checked("${CMAKE_COMMAND}" --build "${project}/build" --config Release --parallel 2)
file(GLOB_RECURSE remarks "${project}/build/*.obj.opt.yaml")
file(GLOB_RECURSE timings "${project}/build/*.obj.time.json")
if(NOT remarks OR NOT timings)
    message(FATAL_ERROR "Optional LLVM optimization/compile reports were not produced")
endif()
file(GLOB_RECURSE objects "${project}/build/*generated.obj" "${project}/build/*iop-code-*.obj")
foreach(object IN LISTS objects)
    file(TIMESTAMP "${object}" before)
    list(APPEND timestamps "${before}")
endforeach()
checked("${CMAKE_COMMAND}" --build "${project}/build" --config Release --parallel 2)
set(index 0)
foreach(object IN LISTS objects)
    file(TIMESTAMP "${object}" after)
    list(GET timestamps ${index} before)
    if(NOT before STREQUAL after)
        message(FATAL_ERROR "Unchanged LLVM object was unnecessarily rebuilt: ${object}")
    endif()
    math(EXPR index "${index}+1")
endforeach()
