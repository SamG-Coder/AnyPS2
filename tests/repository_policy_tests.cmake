# Exercise the real Git index: the working file can differ from staged content.
find_package(Git REQUIRED)
set(repository "${SCRATCH}/repository")
file(MAKE_DIRECTORY "${repository}/tests")
execute_process(COMMAND "${GIT_EXECUTABLE}" init -q "${repository}"
    RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot initialize policy fixture repository")
endif()
file(WRITE "${repository}/tests/fixture.cpp" "MZsynthetic staged binary")
execute_process(COMMAND "${GIT_EXECUTABLE}" add tests/fixture.cpp
    WORKING_DIRECTORY "${repository}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot stage policy fixture")
endif()
file(WRITE "${repository}/tests/fixture.cpp" "int original_synthetic_fixture;\n")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DROOT=${repository}"
    "-DSCRATCH=${SCRATCH}/index-check" -P "${POLICY}"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0)
    message(FATAL_ERROR "Policy missed binary staged behind a clean working file")
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" add tests/fixture.cpp
    WORKING_DIRECTORY "${repository}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot stage clean policy fixture")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" "-DROOT=${repository}"
    "-DSCRATCH=${SCRATCH}/index-check" -P "${POLICY}"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Policy rejected clean synthetic repository")
endif()
message(STATUS "Repository policy rejection fixtures passed")
