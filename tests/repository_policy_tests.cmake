cmake_minimum_required(VERSION 3.24)
file(MAKE_DIRECTORY "${SCRATCH}")
function(expect name content should_pass)
    file(WRITE "${SCRATCH}/fixture" "${content}")
    execute_process(COMMAND "${CMAKE_COMMAND}"
        "-DCHECK_FILE=${SCRATCH}/fixture" "-DCHECK_NAME=${name}"
        -P "${POLICY}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
    if(should_pass AND NOT result EQUAL 0)
        message(FATAL_ERROR "Policy rejected synthetic source: ${name}")
    elseif(NOT should_pass AND NOT result EQUAL 1)
        message(FATAL_ERROR "Policy must reject excluded fixture cleanly: ${name}; exit=${result}")
    endif()
endfunction()
