cmake_minimum_required(VERSION 3.24)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(run "${SCRATCH}/${id}")
file(MAKE_DIRECTORY "${run}")
function(convert source output expected)
    execute_process(COMMAND "${CONVERTER}" "${source}" "${run}/${output}" --whole-code ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
    if(NOT status EQUAL expected)
        message(FATAL_ERROR "Whole-code conversion returned ${status}, expected ${expected}: ${out} ${err}")
    endif()
endfunction()
convert("${INPUT}" complete 0)
file(READ "${run}/complete/code-coverage.txt" coverage)
if(NOT coverage MATCHES "selection=whole-declared-EE-code" OR NOT coverage MATCHES "selected_instructions=16")
    message(FATAL_ERROR "Whole code was replaced with root discovery: ${coverage}")
endif()
file(READ "${run}/complete/observed-call-edges.tsv" observed)
if(observed MATCHES "validated-native-stop")
    message(FATAL_ERROR "Whole-code conversion used runtime evidence")
endif()
convert("${UNSUPPORTED}" unsupported 2 --verify-only)
file(READ "${run}/unsupported/lowering-diagnostics.txt" diagnostics)
if(NOT diagnostics MATCHES "2 occurrence")
    message(FATAL_ERROR "Unused unsupported words were silently skipped: ${diagnostics}")
endif()
# The source copy includes unsupported data; explicit code metadata retains it
# as payload storage without compiling it as an instruction or needing a caller.
file(WRITE "${run}/payloads.txt" "0x1000 0x3000 0x50 0x10 0x20 code=0:0x40\n")
convert("${INPUT}" mixed-copy 0 --payloads "${run}/payloads.txt")
file(READ "${run}/mixed-copy/code-coverage.txt" coverage)
if(NOT coverage MATCHES "selected_instructions=32")
    message(FATAL_ERROR "Mixed payload lost declared code or promoted its data: ${coverage}")
endif()
file(WRITE "${run}/payloads.txt" "0x1000 0x3000 0x50 0x40 code=0:0x40\n")
convert("${INPUT}" data-entry 1 --payloads "${run}/payloads.txt")
if(EXISTS "${run}/data-entry")
    message(FATAL_ERROR "Invalid classification published a partial project")
endif()
