cmake_minimum_required(VERSION 3.24)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(run "${SCRATCH}/${id}")
file(MAKE_DIRECTORY "${run}")
function(checked)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 90)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Native image pipeline failed: ${out} ${err}")
    endif()
endfunction()
checked("${FIXTURE}" "${run}/fixture.ll" "${run}/fixture.elf")
execute_process(COMMAND "${CONVERTER}" "${run}/fixture.elf.loader" "${run}/invalid"
    --image "${run}/fixture.elf.loader" RESULT_VARIABLE result ERROR_VARIABLE err)
if(NOT result EQUAL 1 OR EXISTS "${run}/invalid")
    message(FATAL_ERROR "Overlapping native images accepted: ${err}")
endif()
checked("${CONVERTER}" "${run}/fixture.elf.loader" "${run}/project" --image "${run}/fixture.elf.image")
checked("${CONVERTER}" "${run}/fixture.elf.loader" "${run}/boot-only")
file(SHA256 "${run}/project/program.data" combined)
file(SHA256 "${run}/boot-only/program.data" boot)
if(NOT combined STREQUAL boot)
    message(FATAL_ERROR "Secondary image was incorrectly initialized before loader execution")
endif()
set(platform)
if(PLATFORM)
    list(APPEND platform -A "${PLATFORM}")
endif()
checked("${CMAKE_COMMAND}" -S "${run}/project" -B "${run}/build" -G "${GENERATOR}" ${platform} "-DANYPS2_ROOT=${ROOT}")
checked("${CMAKE_COMMAND}" --build "${run}/build" --config Release --target ps2-native --parallel 2)
set(executable "${run}/build/Release/ps2-native${EXE_SUFFIX}")
execute_process(COMMAND "${executable}" "${run}/project/program.data" --headless RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT result EQUAL 3 OR NOT out MATCHES "stop=1 pc=0x00003008.*v0=86" OR NOT out MATCHES "native_image=2")
    message(FATAL_ERROR "Compiled loader did not launch the second native image: ${out} ${err}")
endif()
file(READ "${executable}.audit.txt" audit)
if(NOT audit MATCHES "dependency audit passed")
    message(FATAL_ERROR "Native image output failed dependency audit")
endif()

# No ELF section names or manually supplied callback addresses: recover the
# referenced list, compile both callbacks and observe their combined writes.
checked("${CONVERTER}" "${run}/fixture.elf.constructors" "${run}/constructors")
checked("${CMAKE_COMMAND}" -S "${run}/constructors" -B "${run}/constructors-build" -G "${GENERATOR}" ${platform} "-DANYPS2_ROOT=${ROOT}")
checked("${CMAKE_COMMAND}" --build "${run}/constructors-build" --config Release --target ps2-native --parallel 2)
execute_process(COMMAND "${run}/constructors-build/Release/ps2-native${EXE_SUFFIX}" "${run}/constructors/program.data" --headless
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT result EQUAL 3 OR NOT out MATCHES "stop=1 pc=0x00001028.*v0=8")
    message(FATAL_ERROR "Recovered lifecycle callbacks did not execute: ${out} ${err}")
endif()

checked("${CONVERTER}" "${run}/fixture.elf.indirect" "${run}/indirect")
checked("${CMAKE_COMMAND}" -S "${run}/indirect" -B "${run}/indirect-build" -G "${GENERATOR}" ${platform} "-DANYPS2_ROOT=${ROOT}")
checked("${CMAKE_COMMAND}" --build "${run}/indirect-build" --config Release --target ps2-native --parallel 2)
execute_process(COMMAND "${run}/indirect-build/Release/ps2-native${EXE_SUFFIX}" "${run}/indirect/program.data" --headless
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT result EQUAL 3 OR NOT out MATCHES "stop=1 pc=0x0000101c.*v0=9")
    message(FATAL_ERROR "Recovered argument-register callback did not execute: ${out} ${err}")
endif()

checked("${CONVERTER}" "${run}/fixture.elf.descriptors" "${run}/descriptors")
checked("${CMAKE_COMMAND}" -S "${run}/descriptors" -B "${run}/descriptors-build" -G "${GENERATOR}" ${platform} "-DANYPS2_ROOT=${ROOT}")
checked("${CMAKE_COMMAND}" --build "${run}/descriptors-build" --config Release --target ps2-native --parallel 2)
execute_process(COMMAND "${run}/descriptors-build/Release/ps2-native${EXE_SUFFIX}" "${run}/descriptors/program.data" --headless
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT result EQUAL 3 OR NOT out MATCHES "stop=1 pc=0x00001010.*v0=6")
    message(FATAL_ERROR "Recovered callback descriptor did not execute: ${out} ${err}")
endif()

checked("${CONVERTER}" "${run}/fixture.elf.modules" "${run}/modules")
if(NOT EXISTS "${run}/modules/generated-1.ll")
    message(FATAL_ERROR "Large native program was not split into bounded modules")
endif()
checked("${CMAKE_COMMAND}" -S "${run}/modules" -B "${run}/modules-build" -G "${GENERATOR}" ${platform} "-DANYPS2_ROOT=${ROOT}")
checked("${CMAKE_COMMAND}" --build "${run}/modules-build" --config Release --target ps2-native --parallel 2)
execute_process(COMMAND "${run}/modules-build/Release/ps2-native${EXE_SUFFIX}" "${run}/modules/program.data" 20000 --headless
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT result EQUAL 3 OR NOT out MATCHES "stop=1 pc=0x00011008 executed=16386 v0=9")
    message(FATAL_ERROR "Native code did not execute across module boundaries: ${out} ${err}")
endif()

checked("${CONVERTER}" "${run}/fixture.elf.conditional-callback" "${run}/conditional-callback")
checked("${CMAKE_COMMAND}" -S "${run}/conditional-callback" -B "${run}/conditional-callback-build" -G "${GENERATOR}" ${platform} "-DANYPS2_ROOT=${ROOT}")
checked("${CMAKE_COMMAND}" --build "${run}/conditional-callback-build" --config Release --target ps2-native --parallel 2)
execute_process(COMMAND "${run}/conditional-callback-build/Release/ps2-native${EXE_SUFFIX}" "${run}/conditional-callback/program.data" --headless
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT result EQUAL 3 OR NOT out MATCHES "stop=1 pc=0x00001028.*v0=73")
    message(FATAL_ERROR "Conditionally stored callback did not execute: ${out} ${err}")
endif()

checked("${CONVERTER}" "${run}/fixture.elf.invoked-callback" "${run}/invoked-callback")
checked("${CMAKE_COMMAND}" -S "${run}/invoked-callback" -B "${run}/invoked-callback-build" -G "${GENERATOR}" ${platform} "-DANYPS2_ROOT=${ROOT}")
checked("${CMAKE_COMMAND}" --build "${run}/invoked-callback-build" --config Release --target ps2-native --parallel 2)
execute_process(COMMAND "${run}/invoked-callback-build/Release/ps2-native${EXE_SUFFIX}" "${run}/invoked-callback/program.data" --headless
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT result EQUAL 3 OR NOT out MATCHES "stop=1 pc=0x0000100c.*v0=91")
    message(FATAL_ERROR "Callback invoked through a saved argument did not execute: ${out} ${err}")
endif()
