cmake_minimum_required(VERSION 3.24)
if(NOT EXISTS "${PROBE}" OR NOT EXISTS "${IMAGE}" OR EXPECTED STREQUAL "")
    message(FATAL_ERROR "A local probe, image, and expected diagnostic regex are required")
endif()
if(NOT DEFINED BUDGET)
    set(BUDGET 1000000)
endif()
execute_process(COMMAND "${PROBE}" "${IMAGE}" "${BUDGET}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
file(WRITE "${LOG}" "${output}\n${error}")
if(NOT result EQUAL 3 OR NOT output MATCHES "${EXPECTED}")
    message(FATAL_ERROR "Startup regression: exit=${result}; inspect ${LOG}")
endif()
message(STATUS "Expected startup diagnostic reached; this does not verify game boot")
