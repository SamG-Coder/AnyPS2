cmake_minimum_required(VERSION 3.24)
if(NOT EXISTS "${PROBE}" OR NOT EXISTS "${IMAGE}" OR EXPECTED STREQUAL "")
    message(FATAL_ERROR "A local probe, image, and expected diagnostic regex are required")
endif()
if(NOT DEFINED BUDGET)
    set(BUDGET 1000000)
endif()
if(NOT DEFINED EXPECTED_EXIT)
    set(EXPECTED_EXIT 3)
endif()
if(NOT EXPECTED_EXIT MATCHES "^[34]$")
    message(FATAL_ERROR "Expected exit must be 3 (diagnostic stop) or 4 (explicit budget boundary)")
endif()
set(options)
if(DEFINED DISC AND NOT DISC STREQUAL "")
    list(APPEND options "--disc=${DISC}")
endif()
execute_process(COMMAND "${PROBE}" "${IMAGE}" "${BUDGET}" ${options}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
file(WRITE "${LOG}" "${output}\n${error}")
if(NOT result EQUAL EXPECTED_EXIT OR NOT output MATCHES "${EXPECTED}")
    message(FATAL_ERROR "Startup regression: exit=${result}; inspect ${LOG}")
endif()
message(STATUS "Expected startup diagnostic reached; this does not verify game boot")
