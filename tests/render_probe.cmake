if(NOT DEFINED PROBE OR NOT DEFINED PREFIX)
    message(FATAL_ERROR "PROBE and PREFIX are required")
endif()
execute_process(COMMAND "${PROBE}" "${PREFIX}.bin" 1 0 6 manifest --native-f32 1 2 3 4
    RESULT_VARIABLE status OUTPUT_VARIABLE report ERROR_VARIABLE error)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Render probe failed: ${error}")
endif()
file(READ "${PREFIX}.json" expected)
if(NOT report STREQUAL expected)
    message(FATAL_ERROR "Render probe manifest does not match the lifted fixture")
endif()
foreach(format cpu-llvm spirv-llvm)
    execute_process(COMMAND "${PROBE}" "${PREFIX}.bin" 1 0 6 "${format}" --native-f32 1 2 3 4
        RESULT_VARIABLE status OUTPUT_VARIABLE emitted ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Render probe emission failed: ${error}")
    endif()
    if(format STREQUAL "cpu-llvm")
        file(READ "${PREFIX}.cpu.ll" expected_ir)
    else()
        file(READ "${PREFIX}.gpu.ll" expected_ir)
    endif()
    if(NOT emitted STREQUAL expected_ir)
        message(FATAL_ERROR "Render probe emitted a different kernel")
    endif()
endforeach()
execute_process(COMMAND "${PROBE}" "${PREFIX}.bin" 1 0 6 manifest --implicit
    RESULT_VARIABLE status OUTPUT_VARIABLE unexpected)
if(status EQUAL 0 OR NOT unexpected STREQUAL "")
    message(FATAL_ERROR "Render probe accepted an implicit numerical policy")
endif()
execute_process(COMMAND "${PROBE}" "${PREFIX}.bin" 2 0 6 manifest --native-f32
    RESULT_VARIABLE status OUTPUT_VARIABLE unexpected)
if(status EQUAL 0 OR NOT unexpected STREQUAL "")
    message(FATAL_ERROR "Render probe accepted an invalid unit")
endif()

# Descriptor numbers are independent of the resource type's IsWriteable flag.
# These structural checks complement, but do not replace, spirv-val and GPU tests.
file(READ "${PREFIX}.gpu.ll" shader)
string(FIND "${shader}" "%uniforms = call target(\"spirv.VulkanBuffer\", [0 x i32], 12, 0)" readonly_uniform)
string(FIND "${shader}" "i32 0, i32 2, i32 1, i32 0, ptr @uniforms_name)" uniform_binding)
string(FIND "${shader}" "_12_2t" invalid_type)
string(FIND "${shader}" "store float" type_punned_store)
if(readonly_uniform EQUAL -1 OR uniform_binding EQUAL -1 OR NOT invalid_type EQUAL -1 OR NOT type_punned_store EQUAL -1)
    message(FATAL_ERROR "Render shader has an invalid resource access type or storage element type")
endif()
foreach(intrinsic handlefrombinding getpointer.p11)
    if(intrinsic STREQUAL "handlefrombinding")
        set(declaration "declare target(\"spirv.VulkanBuffer\", [0 x i32], 12, 0) @llvm.spv.resource.handlefrombinding.tspirv.VulkanBuffer_a0i32_12_0t")
    else()
        set(declaration "declare ptr addrspace(11) @llvm.spv.resource.getpointer.p11.tspirv.VulkanBuffer_a0i32_12_0t")
    endif()
    string(FIND "${shader}" "${declaration}" first)
    if(first EQUAL -1)
        message(FATAL_ERROR "Missing read-only resource intrinsic declaration")
    endif()
    math(EXPR next "${first} + 1")
    string(SUBSTRING "${shader}" ${next} -1 tail)
    string(FIND "${tail}" "${declaration}" duplicate)
    if(NOT duplicate EQUAL -1)
        message(FATAL_ERROR "Read-only resource intrinsic is declared more than once")
    endif()
endforeach()
string(REGEX MATCHALL "store i32 %output_bits[0-9]+" output_stores "${shader}")
list(LENGTH output_stores output_store_count)
if(NOT output_store_count EQUAL 4)
    message(FATAL_ERROR "Render fixture must store four encoded output words")
endif()
