if(NOT DEFINED PROBE OR NOT DEFINED PREFIX OR NOT DEFINED DESTINATION)
    message(FATAL_ERROR "PROBE, PREFIX and DESTINATION are required")
endif()
foreach(format manifest cpu-llvm spirv-llvm)
    execute_process(COMMAND "${PROBE}" "${PREFIX}.bin" 1 "${DESTINATION}" "${format}" --native-f32
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Loop probe failed: ${error}")
    endif()
    if(format STREQUAL "manifest")
        set(suffix json)
    elseif(format STREQUAL "cpu-llvm")
        set(suffix cpu.ll)
    else()
        set(suffix gpu.ll)
    endif()
    file(READ "${PREFIX}.${suffix}" expected)
    if(NOT output STREQUAL expected)
        message(FATAL_ERROR "Loop probe and API output differ for ${format}")
    endif()
endforeach()
foreach(invalid_policy --implicit --native-f64)
    execute_process(COMMAND "${PROBE}" "${PREFIX}.bin" 1 "${DESTINATION}" manifest "${invalid_policy}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output)
    if(status EQUAL 0 OR NOT output STREQUAL "")
        message(FATAL_ERROR "Loop probe accepted an invalid numerical policy")
    endif()
endforeach()
foreach(unit 2 junk)
    execute_process(COMMAND "${PROBE}" "${PREFIX}.bin" "${unit}" "${DESTINATION}" manifest --native-f32
        RESULT_VARIABLE status OUTPUT_VARIABLE output)
    if(status EQUAL 0 OR NOT output STREQUAL "")
        message(FATAL_ERROR "Loop probe accepted an invalid unit")
    endif()
endforeach()
file(READ "${PREFIX}.gpu.ll" shader)
string(FIND "${shader}" "%parameters = call target(\"spirv.VulkanBuffer\", [0 x i32], 12, 0)" readonly_parameters)
string(FIND "${shader}" "i32 0, i32 2, i32 1, i32 0, ptr @parameters_name)" parameter_binding)
string(FIND "${shader}" "_12_2t" invalid_type)
string(FIND "${shader}" "store float" invalid_store)
if(readonly_parameters EQUAL -1 OR parameter_binding EQUAL -1 OR NOT invalid_type EQUAL -1 OR NOT invalid_store EQUAL -1)
    message(FATAL_ERROR "Invalid loop shader resource declaration or element type")
endif()
