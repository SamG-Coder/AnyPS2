function(anyps2_add_audio target)
    add_library(${target} "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/src/output.cpp")
    target_include_directories(${target} PUBLIC "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/include")
    target_compile_features(${target} PUBLIC cxx_std_20)
    if(WIN32)
        target_link_libraries(${target} PRIVATE xaudio2 xapobase ole32)
    endif()
endfunction()
