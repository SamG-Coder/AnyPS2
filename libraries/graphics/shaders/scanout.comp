#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0,std430) buffer Memory { uint pixels[]; } memory;
#include "display_composition.glsl"
uint address(uint base,uint pitch,uint x,uint y) {
    x &= 2047; y &= 2047;
    uint page=(y/32)*pitch+x/64;
    uint block=((x>>3)&1)|(((y>>3)&1)<<1)|(((x>>4)&1)<<2)|(((y>>4)&1)<<3)|(((x>>5)&1)<<4);
    uint word=(x&1)|((y&1)<<1)|((x&6)<<1)|((y&6)<<3);
    return (base*64+page*2048+block*64+word)&0xfffff;
}
uint sample_surface(uint index,uint x,uint y) {
    Surface s=display.surfaces[index];
    x-=s.offset_x; y-=s.offset_y;
    return memory.pixels[address(s.base,s.pitch,s.x+x,s.y+(display.half_height!=0 ? y/2 : y))]|0xff000000;
}
void main() {
    uint x=gl_GlobalInvocationID.x,y=gl_GlobalInvocationID.y;
    if (x>=display.width || y>=display.height) return;
    uint color=compose_display(x,y);
    if (display.bgra!=0) color=(color&0xff00ff00)|((color&255)<<16)|((color>>16)&255);
    uint index=2359552+y*display.width+x;
    if (memory.pixels[index]!=color) atomicOr(memory.pixels[2359551],1);
    memory.pixels[index]=color;
}
