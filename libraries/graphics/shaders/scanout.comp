#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0,std430) buffer Memory { uint pixels[]; } memory;
#include "display_composition.glsl"
uint address(uint base,uint pitch,uint x,uint y) {
    x &= 2047; y &= 2047;
    uint page=(y/32)*pitch+x/64;
    uint block=((x>>3)&1)|(((y>>3)&1)<<1)|(((x>>4)&1)<<2)|(((y>>4)&1)<<3)|(((x>>5)&1)<<4);
    uint word=(x&1)|((y&1)<<1)|((x&6)<<1)|((y&6)<<3);
    return (base*64+page*2048+block*64+word)&0xfffff;
}
uint halfword_address(uint base,uint pitch,uint x,uint y,bool alternate) {
    x&=2047u; y&=2047u;
    uint page=(y/64u)*pitch+x/64u;
    uint block=((y>>3)&1u)|(((x>>4)&1u)<<1)|
        (alternate ? (((y>>5)&1u)<<2)|(((y>>4)&1u)<<3)|(((x>>5)&1u)<<4) :
                     (((y>>4)&1u)<<2)|(((x>>5)&1u)<<3)|(((y>>5)&1u)<<4));
    uint h=((x>>3)&1u)|((x&1u)<<1)|((y&1u)<<2)|((x&6u)<<2)|((y&6u)<<4);
    return (base*128u+page*4096u+block*128u+h)&0x1fffffu;
}
uint sample_surface(uint index,uint x,uint y) {
    Surface s=display.surfaces[index];
    x-=s.offset_x; y-=s.offset_y;
    uint row=s.y+(display.half_height!=0 ? y/2 : y);
    if (s.format!=0) {
        uint half_address=halfword_address(s.base,s.pitch,s.x+x,row,s.format==10u);
        uint value=(memory.pixels[half_address/2u]>>((half_address%2u)*16u))&0xffffu;
        return ((value&31u)<<3)|(((value>>5)&31u)<<11)|(((value>>10)&31u)<<19)|0xff000000u;
    }
    return memory.pixels[address(s.base,s.pitch,s.x+x,row)]|0xff000000;
}
void main() {
    uint x=gl_GlobalInvocationID.x,y=gl_GlobalInvocationID.y;
    if (x>=display.width || y>=display.height) return;
    uint color=compose_display(x,y);
    if (display.bgra!=0) color=(color&0xff00ff00)|((color&255)<<16)|((color>>16)&255);
    uint index=2359552+y*display.width+x;
    if (memory.pixels[index]!=color) atomicOr(memory.pixels[2359551],1);
    memory.pixels[index]=color;
}
