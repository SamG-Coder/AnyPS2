#version 450
#extension GL_ARB_gpu_shader_int64 : require
// GS primitive assembly for GPU-produced vertex records. One dispatch covers a
// table of batches; each invocation finds its batch, then writes one native draw
// record per primitive slot in submission order, and per element checks the
// element kernel's status word. This repeats the triangle and sprite paths of
// NativeDrawing::command, plan_triangle and plan_sprite for what NativeDrawing
// sends here; tests compare it with that CPU path.
layout(local_size_x=64) in;
// Device memory holding plans and records (word offsets come from the table).
layout(std430,set=0,binding=0) readonly buffer Memory { uint words[]; } memory;
layout(std430,set=0,binding=1) writeonly buffer Records { uint words[]; } records;
// Batch count, then per batch: first item, plan word, record word, status word;
// then the total item count.
layout(std430,set=0,binding=2) readonly buffer Table { uint words[]; } table;
layout(std430,set=0,binding=3) buffer Status { uint words[]; } status;

// Plan words, written by NativeVectors from VectorAssembly.
const uint plan_elements=0u, plan_element_words=1u, plan_record_first=2u, plan_primitive=3u;
const uint plan_shaded=4u, plan_coverage=5u, plan_xyz_register=6u, plan_present=7u;
const uint plan_offset=8u, plan_scissor=10u, plan_store=14u, plan_constant=34u, plan_state=54u;
const uint plan_reglist=60u, plan_template=64u;
// DrawRecord words (native_raster.cpp, native.vert).
const uint record_words=80u, record_left=0u, record_color=6u, record_vertices=32u, record_fog=65u;
const uint record_x0=16u, record_depth=31u, record_lod_q=67u, record_flags=12u;

uint plan_base=0u,record_base=0u;
uint P(uint index) { return memory.words[plan_base+index]; }
uint register_word(uint element,uint kind,uint n) {
    const uint store=P(plan_store+kind*4u+n);
    return store==0xffffffffu ? P(plan_constant+kind*4u+n) : memory.words[record_base+element*P(plan_element_words)+1u+store];
}
struct Vertex { int x,y; uint color,u,v,s,t,q,z,fog; bool kick,restart; };
// REGLIST register values, as NativeDrawing::command applies them: RGBAQ is
// color and Q, ST is S and T, UV is masked, FOG is the top byte, and the
// position carries Z (24 bits with fog for XYZF) without an ADC bit.
Vertex reglist_vertex(uint element) {
    const uint present=P(plan_present);
    Vertex r;
    r.color=(present&1u)!=0u ? register_word(element,0u,0u) : P(plan_state);
    r.q=(present&1u)!=0u ? register_word(element,0u,1u) : P(plan_state+1u);
    r.s=(present&2u)!=0u ? register_word(element,1u,0u) : P(plan_state+2u);
    r.t=(present&2u)!=0u ? register_word(element,1u,1u) : P(plan_state+3u);
    const uint uv=(present&4u)!=0u ? (register_word(element,2u,0u)&0x3fff3fffu) : P(plan_state+4u);
    r.u=uv&16383u; r.v=(uv>>16)&16383u;
    r.fog=(present&8u)!=0u ? (register_word(element,3u,1u)>>24) : P(plan_state+5u);
    const uint reg=P(plan_xyz_register);
    const uint low=register_word(element,4u,0u),high=register_word(element,4u,1u);
    r.x=int(low&65535u); r.y=int(low>>16);
    if ((reg&1u)==0u) { r.z=high&0xffffffu; r.fog=high>>24; } else r.z=high;
    r.kick=reg<12u; r.restart=false;
    return r;
}
// Resolved vertices carry every value the GS state machine applies at a position
// write, including values written by earlier vertices and the kick decision.
Vertex resolved_vertex(uint element) {
    Vertex r;
    r.color=register_word(element,0u,0u); r.q=register_word(element,0u,1u);
    r.s=register_word(element,1u,0u); r.t=register_word(element,1u,1u);
    const uint uv=register_word(element,2u,0u);
    r.u=uv&16383u; r.v=(uv>>16)&16383u;
    r.fog=register_word(element,3u,0u);
    const uint xy=register_word(element,4u,0u);
    r.x=int(xy&65535u); r.y=int(xy>>16);
    r.z=register_word(element,4u,1u);
    const uint flags=register_word(element,4u,2u);
    r.kick=(flags&1u)!=0u; r.restart=(flags&2u)!=0u;
    return r;
}
Vertex vertex(uint element) {
    if (P(plan_reglist)==2u) return resolved_vertex(element);
    if (P(plan_reglist)!=0u) return reglist_vertex(element);
    const uint present=P(plan_present);
    Vertex r;
    // RGBAQ takes Q from the preceding ST of the same record, otherwise from
    // the value reset at the GIF tag. The host rejects ST after RGBAQ.
    const uint packed_q=(present&2u)!=0u ? register_word(element,1u,2u) : 0x3f800000u;
    r.color=(present&1u)!=0u ? ((register_word(element,0u,0u)&255u)|((register_word(element,0u,1u)&255u)<<8)|
        ((register_word(element,0u,2u)&255u)<<16)|((register_word(element,0u,3u)&255u)<<24)) : P(plan_state);
    r.q=(present&1u)!=0u ? packed_q : P(plan_state+1u);
    r.s=(present&2u)!=0u ? register_word(element,1u,0u) : P(plan_state+2u);
    r.t=(present&2u)!=0u ? register_word(element,1u,1u) : P(plan_state+3u);
    const uint uv=(present&4u)!=0u ?
        (((register_word(element,2u,0u)&16383u)|((register_word(element,2u,1u)&16383u)<<16))&0x3fff3fffu) : P(plan_state+4u);
    r.u=uv&16383u; r.v=(uv>>16)&16383u;
    r.fog=(present&8u)!=0u ? ((register_word(element,3u,3u)>>4)&255u) : P(plan_state+5u);
    const uint reg=P(plan_xyz_register);
    const uint w0=register_word(element,4u,0u),w1=register_word(element,4u,1u);
    const uint w2=register_word(element,4u,2u),w3=register_word(element,4u,3u);
    r.x=int(w0&65535u); r.y=int(w1&65535u);
    if ((reg&1u)==0u) { r.z=(w2>>4)&0xffffffu; r.fog=(w3>>4)&255u; } else r.z=w2;
    // XYZ3/XYZF3 and the ADC bit update the vertex queue without a kick.
    r.kick=reg<12u && (w3&0x8000u)==0u; r.restart=false;
    return r;
}
// Integer division truncates toward zero, as in the C++ planner.
int ceil_pixel(int value) { return value>=0 ? (value+15)/16 : -((-value)/16); }
void write_vertex(uint base,uint index,Vertex v,int ox,int oy) {
    const uint at=base+record_vertices+index*10u;
    records.words[at]=uint(v.x-ox); records.words[at+1u]=uint(v.y-oy);
    records.words[at+2u]=v.color; records.words[at+3u]=v.u; records.words[at+4u]=v.v;
    records.words[at+5u]=v.s; records.words[at+6u]=v.t; records.words[at+7u]=v.q;
    records.words[at+8u]=v.z; records.words[at+9u]=v.fog;
}
// Sprite i is vertices 2i and 2i+1, as NativeDrawing latches and kicks them:
// bounds as plan_sprite, texture mapping as plan_sprite_texture (UV only), and
// color, depth, fog and LOD Q from the kicking vertex.
void sprite(uint item) {
    const Vertex first=vertex(item*2u),last=vertex(item*2u+1u);
    const uint base=(P(plan_record_first)+item)*record_words;
    for (uint w=0u;w<record_words;++w) records.words[base+w]=P(plan_template+w);
    const int ox=int(P(plan_offset)),oy=int(P(plan_offset+1u));
    const int left=max(ceil_pixel(min(first.x,last.x)-ox),int(P(plan_scissor)));
    const int right=min(ceil_pixel(max(first.x,last.x)-ox),int(P(plan_scissor+1u))+1);
    const int top=max(ceil_pixel(min(first.y,last.y)-oy),int(P(plan_scissor+2u)));
    const int bottom=min(ceil_pixel(max(first.y,last.y)-oy),int(P(plan_scissor+3u))+1);
    if (!last.kick || left>=right || top>=bottom) {
        // No draw: an empty rectangle rasterizes no fragments.
        for (uint w=0u;w<4u;++w) records.words[base+record_left+w]=0u;
        return;
    }
    records.words[base+record_left]=uint(left); records.words[base+record_left+1u]=uint(top);
    records.words[base+record_left+2u]=uint(right); records.words[base+record_left+3u]=uint(bottom);
    records.words[base+record_color]=last.color; records.words[base+record_depth]=last.z;
    records.words[base+record_fog]=last.fog;
    if ((P(plan_template+record_flags)&1u)!=0u) {
        records.words[base+record_x0]=uint(first.x-ox); records.words[base+record_x0+1u]=uint(first.y-oy);
        records.words[base+record_x0+2u]=uint(last.x-first.x); records.words[base+record_x0+3u]=uint(last.y-first.y);
        records.words[base+record_x0+4u]=first.u; records.words[base+record_x0+5u]=first.v;
        records.words[base+record_x0+6u]=uint(int(last.u)-int(first.u)); records.words[base+record_x0+7u]=uint(int(last.v)-int(first.v));
        records.words[base+record_lod_q]=last.q;
    }
}
// A point fills the pixel nearest its position, as plan_line_or_point, with the
// color, depth and fog of a sprite's kicking vertex.
int nearest_pixel(int value) { const int shifted=value+8; return shifted>=0 ? shifted/16 : (shifted-15)/16; }
void point(uint item) {
    const Vertex v=vertex(item);
    const uint base=(P(plan_record_first)+item)*record_words;
    for (uint w=0u;w<record_words;++w) records.words[base+w]=P(plan_template+w);
    const int x=nearest_pixel(v.x-int(P(plan_offset))),y=nearest_pixel(v.y-int(P(plan_offset+1u)));
    const int left=max(x,int(P(plan_scissor))),right=min(x+1,int(P(plan_scissor+1u))+1);
    const int top=max(y,int(P(plan_scissor+2u))),bottom=min(y+1,int(P(plan_scissor+3u))+1);
    if (!v.kick || left>=right || top>=bottom) {
        for (uint w=0u;w<4u;++w) records.words[base+record_left+w]=0u;
        return;
    }
    records.words[base+record_left]=uint(left); records.words[base+record_left+1u]=uint(top);
    records.words[base+record_left+2u]=uint(right); records.words[base+record_left+3u]=uint(bottom);
    records.words[base+record_color]=v.color; records.words[base+record_depth]=v.z;
    records.words[base+record_fog]=v.fog;
}
void main() {
    const uint id=gl_GlobalInvocationID.x;
    const uint batches=table.words[0];
    if (id>=table.words[1u+batches*4u]) return;
    uint low=0u,high=batches-1u;
    while (low<high) {
        const uint middle=(low+high+1u)/2u;
        if (table.words[1u+middle*4u]<=id) low=middle; else high=middle-1u;
    }
    const uint entry=1u+low*4u;
    const uint item=id-table.words[entry];
    plan_base=table.words[entry+1u]; record_base=table.words[entry+2u];
    const uint count=P(plan_elements);
    if (item<count && memory.words[record_base+item*P(plan_element_words)]!=0u) atomicAdd(status.words[table.words[entry+3u]],1u);
    const uint primitive=P(plan_primitive);
    if (primitive==0u) { if (item<count) point(item); return; }
    if (primitive==6u) { if (item<count/2u) sprite(item); return; }
    const uint primitives=primitive==3u ? count/3u : (count>=2u ? count-2u : 0u);
    if (item>=primitives) return;
    const uint a=primitive==3u ? item*3u : primitive==4u ? item : 0u;
    const uint b=primitive==3u ? item*3u+1u : item+1u;
    const uint c=primitive==3u ? item*3u+2u : item+2u;
    const uint base=(P(plan_record_first)+item)*record_words;
    for (uint w=0u;w<record_words;++w) records.words[base+w]=P(plan_template+w);
    // Failed elements have no usable stores. Suppress their primitives before
    // reading those stores; the slot's failure counter remains observable.
    if ((memory.words[record_base+a*P(plan_element_words)]|memory.words[record_base+b*P(plan_element_words)]|
         memory.words[record_base+c*P(plan_element_words)])!=0u) {
        for (uint w=0u;w<4u;++w) records.words[base+record_left+w]=0u;
        for (uint w=0u;w<30u;++w) records.words[base+record_vertices+w]=0u;
        return;
    }
    Vertex v0=vertex(a),v1=vertex(b),v2=vertex(c);
    const int coverage=P(plan_coverage)!=0u ? 15 : 0;
    const int ox=int(P(plan_offset)),oy=int(P(plan_offset+1u));
    const int x0=max(0,min(v0.x,min(v1.x,v2.x))-coverage),x1=max(v0.x,max(v1.x,v2.x));
    const int y0=max(0,min(v0.y,min(v1.y,v2.y))-coverage),y1=max(v0.y,max(v1.y,v2.y));
    const int left=max(ceil_pixel(x0-ox),int(P(plan_scissor)));
    const int right=min(ceil_pixel(x1-ox),int(P(plan_scissor+1u))+1);
    const int top=max(ceil_pixel(y0-oy),int(P(plan_scissor+2u)));
    const int bottom=min(ceil_pixel(y1-oy),int(P(plan_scissor+3u))+1);
    const int64_t area=int64_t(v1.x-v0.x)*int64_t(v2.y-v0.y)-int64_t(v1.y-v0.y)*int64_t(v2.x-v0.x);
    // A triangle spanning a strip restart does not exist in the source stream.
    if (!v2.kick || v1.restart || v2.restart || left>=right || top>=bottom || area==0) {
        // No draw: an empty, zero-area record rasterizes no fragments.
        for (uint w=0u;w<4u;++w) records.words[base+record_left+w]=0u;
        for (uint w=0u;w<30u;++w) records.words[base+record_vertices+w]=0u;
        return;
    }
    // Flat color and the draw's fog come from the kicking vertex.
    const uint color=v2.color,fog=v2.fog;
    if (area<0) { const Vertex swapped=v1; v1=v2; v2=swapped; }
    records.words[base+record_left]=uint(left); records.words[base+record_left+1u]=uint(top);
    records.words[base+record_left+2u]=uint(right); records.words[base+record_left+3u]=uint(bottom);
    records.words[base+record_color]=color; records.words[base+record_fog]=fog;
    write_vertex(base,0u,v0,ox,oy); write_vertex(base,1u,v1,ox,oy); write_vertex(base,2u,v2,ox,oy);
}
