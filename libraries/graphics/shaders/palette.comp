#version 450
// GPU-resident palettes and indexed texture decoding for sources that a
// native surface holds (rendered memory), so neither needs a CPU readback.
// Mode 0 gathers palette words into a slot; mode 1 decodes an indexed texture
// through a slot; mode 2 applies host image writes to a rendered surface;
// mode 3 copies the owned pages of a rendered surface into the memory mirror;
// mode 5 is its inverse, loading the owned pages of a surface from the mirror.
// Addresses follow nt/pixel_address.hpp exactly.
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0) uniform usampler2D surface;          // CT32 surface image
layout(std430,set=0,binding=1) buffer Palettes { uint words[]; } palettes;
layout(set=0,binding=2,r32ui) uniform uimage2D decoded;          // output (mode 2: the surface)
// GPU copy of console memory; mode 3 publishes a rendered surface's pages into it.
layout(std430,set=0,binding=3) buffer Mirror { uint words[]; } mirror;
layout(push_constant) uniform Parameters {
    uint mode,surface_base,surface_pitch,surface_width,surface_height;
    uint slot,addresses,count;                    // mode 0: address list at word `addresses`
    uint texture_base,texture_pitch,format,bank,width,height; // mode 1
    uint owned[16];                               // pages whose newest words the surface holds
    uint layouts;                                 // bit 0: surface uses the depth page layout; bit 1: texture does
    uint scale;                                   // samples per console pixel of the surface, along each axis
} p;
// A surface pixel's value in console memory is its center sample.
uint surface_texel(ivec2 pixel) { return texelFetch(surface,pixel*int(p.scale)+int(p.scale/2u),0).r; }
// Memory writes replace every sample of the pixel, keeping the bits in `keep`.
void store_surface(ivec2 pixel,uint value,uint keep) {
    for (int j=0;j<int(p.scale);++j) for (int i=0;i<int(p.scale);++i) {
        const ivec2 at=pixel*int(p.scale)+ivec2(i,j);
        imageStore(decoded,at,uvec4((imageLoad(decoded,at).r&keep)|value));
    }
}
// Inverse of rgba_word for the surface: the pixel holding a word address,
// or false when the word lies outside the surface image.
// Inverse of rgba_halfword for a 16-bit surface (layouts bit 2; bit 3 PSMCT16S):
// the pixel holding `halfword`, or false outside the image.
bool surface_pixel16(uint halfword,out ivec2 pixel) {
    const uint relative=(halfword-p.surface_base*128u)&0x1fffffu;
    const uint page=relative/4096u,block=(relative/128u)%32u,h=relative%128u;
    const uint pitch=max(p.surface_pitch,1u);
    const bool alternate=(p.layouts&8u)!=0u;
    const uint x4=(block>>1)&1u,x5=alternate ? (block>>4)&1u : (block>>3)&1u;
    const uint y3=block&1u,y4=alternate ? (block>>3)&1u : (block>>2)&1u,y5=alternate ? (block>>2)&1u : (block>>4)&1u;
    const uint x=(page%pitch)*64u+(x5<<5)+(x4<<4)+((h&1u)<<3)+(((h>>3)&3u)<<1)+((h>>1)&1u);
    const uint y=(page/pitch)*64u+(y5<<5)+(y4<<4)+(y3<<3)+(((h>>5)&3u)<<1)+((h>>2)&1u);
    pixel=ivec2(x,y);
    return x<p.surface_width && y<p.surface_height;
}
uint rgba_halfword(uint base,uint pitch,uint x,uint y,bool alternate) {
    x&=2047u; y&=2047u;
    const uint page=(y/64u)*pitch+x/64u;
    const uint block=((y>>3)&1u)|(((x>>4)&1u)<<1)|
        (alternate ? (((y>>5)&1u)<<2)|(((y>>4)&1u)<<3)|(((x>>5)&1u)<<4) :
                     (((y>>4)&1u)<<2)|(((x>>5)&1u)<<3)|(((y>>5)&1u)<<4));
    const uint h=((x>>3)&1u)|((x&1u)<<1)|((y&1u)<<2)|((x&6u)<<2)|((y&6u)<<4);
    return (base*128u+page*4096u+block*128u+h)&0x1fffffu;
}
uint pack16(uint value) {
    return ((value>>3)&31u)|(((value>>11)&31u)<<5)|(((value>>19)&31u)<<10)|((value>>16)&0x8000u);
}
uint expand16(uint value) {
    return ((value&0x8000u)<<16)|((value&31u)<<3)|(((value>>5)&31u)<<11)|(((value>>10)&31u)<<19);
}
// Applies a masked word write to a 16-bit surface: each half it covers.
void write16(uint word,uint value,uint mask) {
    for (uint k=0u;k<2u;++k) {
        const uint half_mask=(mask>>(16u*k))&65535u;
        ivec2 pixel;
        if (half_mask==0u || !surface_pixel16(word*2u+k,pixel)) continue;
        for (int j=0;j<int(p.scale);++j) for (int i=0;i<int(p.scale);++i) {
            const ivec2 at=pixel*int(p.scale)+ivec2(i,j);
            imageStore(decoded,at,uvec4(expand16((pack16(imageLoad(decoded,at).r)&~half_mask)|((value>>(16u*k))&half_mask))));
        }
    }
}
bool surface_pixel(uint word,out ivec2 pixel) {
    // Depth pages permute blocks (word address XOR 0x600) within the page.
    word^=(p.layouts&1u)!=0u ? 0x600u : 0u;
    const uint owner=(word/2048u)&511u;
    if ((p.owned[owner/32u]&(1u<<(owner%32u)))==0u) return false;
    const uint relative=(word-p.surface_base*64u)&0xfffffu;
    const uint page=relative/2048u,within=relative%2048u,block=within/64u,w=within%64u;
    const uint pitch=max(p.surface_pitch,1u);
    const uint x=(page%pitch)*64u+(((block>>4)&1u)<<5)+(((block>>2)&1u)<<4)+((block&1u)<<3)+(((w>>2)&3u)<<1)+(w&1u);
    const uint y=(page/pitch)*32u+(((block>>3)&1u)<<4)+(((block>>1)&1u)<<3)+(((w>>4)&3u)<<1)+((w>>1)&1u);
    pixel=ivec2(x,y);
    return x<p.surface_width && y<p.surface_height;
}
uint rgba_word(uint base,uint pitch,uint x,uint y) {
    x&=2047u; y&=2047u;
    const uint page=(y/32u)*pitch+x/64u;
    const uint block=((x>>3)&1u)|(((y>>3)&1u)<<1)|(((x>>4)&1u)<<2)|(((y>>4)&1u)<<3)|(((x>>5)&1u)<<4);
    const uint word=(x&1u)|((y&1u)<<1)|((x&6u)<<1)|((y&6u)<<3);
    return (base*64u+page*2048u+block*64u+word)&0xfffffu;
}
uint indexed_byte(uint base,uint pitch,uint x,uint y) {
    x&=2047u; y&=2047u;
    const uint page=(y/64u)*(pitch/2u)+x/128u;
    const uint block=((x>>4)&1u)|(((y>>4)&1u)<<1)|(((x>>5)&1u)<<2)|(((y>>5)&1u)<<3)|(((x>>6)&1u)<<4);
    const uint column=((x&1u)<<2)|((x&2u)<<3)|((((x>>2)^(y>>1)^(y>>2))&1u)<<5)|
        ((x&8u)>>2)|((y&1u)<<3)|((y&2u)>>1)|((y&4u)<<4)|((y&8u)<<4);
    return (base*256u+page*8192u+block*256u+column)&0x3fffffu;
}
uint indexed_nibble(uint base,uint pitch,uint x,uint y) {
    x&=2047u; y&=2047u;
    const uint page=(y/128u)*(pitch/2u)+x/128u;
    const uint block=((y>>4)&1u)|(((x>>5)&1u)<<1)|(((y>>5)&1u)<<2)|(((x>>6)&1u)<<3)|(((y>>6)&1u)<<4);
    const uint column=((x&1u)<<3)|((x&2u)<<4)|((((x>>2)^(y>>1)^(y>>2))&1u)<<6)|
        ((x&8u)>>2)|((x&16u)>>2)|((y&1u)<<4)|((y&2u)>>1)|((y&4u)<<5)|((y&8u)<<5);
    return (base*512u+page*16384u+block*512u+column)&0x7fffffu;
}
void main() {
    const uvec2 g=gl_GlobalInvocationID.xy;
    if (p.mode==0u) {
        if (g.y!=0u || g.x>=p.count) return;
        ivec2 pixel;
        const uint word=palettes.words[p.addresses+g.x];
        // Mode 0 writes entries bank.. bank+count-1 (bank is the first entry).
        palettes.words[p.slot*256u+p.bank+g.x]=surface_pixel(word,pixel) ? surface_texel(pixel) : mirror.words[word&0xfffffu];
        return;
    }
    if (p.mode==4u) {
        // Unique (address, value) pairs of whole words.
        if (g.y!=0u || g.x>=p.count) return;
        const uint at=p.addresses+g.x*2u;
        if ((p.layouts&4u)!=0u) { write16(palettes.words[at],palettes.words[at+1u],0xffffffffu); return; }
        ivec2 pixel;
        if (surface_pixel(palettes.words[at],pixel)) store_surface(pixel,palettes.words[at+1u],0u);
        return;
    }
    if (p.mode==2u) {
        // Entries are (address, value, mask) with unique addresses, so
        // invocations never touch the same pixel.
        if (g.y!=0u || g.x>=p.count) return;
        const uint at=p.addresses+g.x*3u;
        const uint mask=palettes.words[at+2u];
        if ((p.layouts&4u)!=0u) { write16(palettes.words[at],palettes.words[at+1u],mask); return; }
        ivec2 pixel;
        if (!surface_pixel(palettes.words[at],pixel)) return;
        store_surface(pixel,palettes.words[at+1u],~mask);
        return;
    }
    if (g.x>=p.width || g.y>=p.height) return;
    if (p.mode==5u) {
        // The dispatch covers the owned pages' rectangle, as in mode 3.
        const uvec2 a=g+uvec2(p.texture_base,p.texture_pitch);
        if ((p.layouts&4u)!=0u) {
            const uint halfword=rgba_halfword(p.surface_base,p.surface_pitch,a.x,a.y,(p.layouts&8u)!=0u);
            const uint word=halfword/2u,page=(word/2048u)&511u;
            if ((p.owned[page/32u]&(1u<<(page%32u)))!=0u)
                store_surface(ivec2(a),expand16((mirror.words[word]>>((halfword%2u)*16u))&65535u),0u);
            return;
        }
        const uint word=rgba_word(p.surface_base,p.surface_pitch,a.x,a.y)^((p.layouts&1u)!=0u ? 0x600u : 0u);
        const uint page=(word/2048u)&511u;
        if ((p.owned[page/32u]&(1u<<(page%32u)))!=0u) store_surface(ivec2(a),mirror.words[word],0u);
        return;
    }
    if (p.mode==3u) {
        // The dispatch covers the owned pages' rectangle at (texture_base,
        // texture_pitch); the surface pixel at a holds this word (export_image's mapping).
        const uvec2 a=g+uvec2(p.texture_base,p.texture_pitch);
        if ((p.layouts&4u)!=0u) {
            // 16-bit surface: each pixel is one halfword of memory. The two
            // halves of a word come from different invocations, so each
            // replaces only its own half atomically.
            const uint halfword=rgba_halfword(p.surface_base,p.surface_pitch,a.x,a.y,(p.layouts&8u)!=0u);
            const uint word=halfword/2u,page=(word/2048u)&511u,shift=(halfword%2u)*16u;
            if ((p.owned[page/32u]&(1u<<(page%32u)))==0u) return;
            atomicAnd(mirror.words[word],~(65535u<<shift));
            atomicOr(mirror.words[word],pack16(surface_texel(ivec2(a)))<<shift);
            return;
        }
        const uint word=rgba_word(p.surface_base,p.surface_pitch,a.x,a.y)^((p.layouts&1u)!=0u ? 0x600u : 0u);
        const uint page=(word/2048u)&511u;
        if ((p.owned[page/32u]&(1u<<(page%32u)))!=0u) mirror.words[word]=surface_texel(ivec2(a));
        return;
    }
    // format: 0 PSMT8, 1 PSMT4, 2 PSMT8H, 3 PSMT4HL, 4 PSMT4HH, 5 PSMCT32 (no palette).
    uint word,shift,mask=255u;
    if (p.format==5u) {
        word=rgba_word(p.texture_base,p.texture_pitch,g.x,g.y)^((p.layouts&2u)!=0u ? 0x600u : 0u);
        ivec2 pixel;
        imageStore(decoded,ivec2(g),uvec4(surface_pixel(word,pixel) ? surface_texel(pixel) : mirror.words[word&0xfffffu]));
        return;
    }
    if (p.format==0u) { const uint b=indexed_byte(p.texture_base,p.texture_pitch,g.x,g.y); word=b/4u; shift=(b%4u)*8u; }
    else if (p.format==1u) { const uint n=indexed_nibble(p.texture_base,p.texture_pitch,g.x,g.y); word=n/8u; shift=(n%8u)*4u; mask=15u; }
    else { word=rgba_word(p.texture_base,p.texture_pitch,g.x,g.y); shift=p.format==4u ? 28u : 24u; mask=p.format==2u ? 255u : 15u; }
    ivec2 pixel;
    const uint index=((surface_pixel(word,pixel) ? surface_texel(pixel) : mirror.words[word&0xfffffu])>>shift)&mask;
    // nt::graphics::snapshot_palette for 32-bit palettes: CSA selects the bank;
    // eight-bit indices keep their low four bits within a clamped bank.
    const uint entry=mask==255u ? min(p.bank+index/16u,15u)*16u+(index&15u) : p.bank*16u+index;
    imageStore(decoded,ivec2(g),uvec4(palettes.words[p.slot*256u+entry]));
}
