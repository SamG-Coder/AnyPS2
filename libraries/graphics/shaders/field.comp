#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0) uniform usampler2D surfaces[2];
// One, two and three fields ago. Never sample the image being written.
layout(set=0,binding=1) uniform usampler2D previous[3];
layout(set=0,binding=2,r32ui) writeonly uniform uimage2D current_field;
layout(set=0,binding=3,r32ui) writeonly uniform uimage2D reconstructed;
#include "display_composition.glsl"
uint sample_surface(uint index,uint x,uint y) {
    Surface s=display.surfaces[index];
    x-=s.offset_x; y-=s.offset_y;
    ivec2 p=ivec2(s.x+x,s.y+y/2);
    return (index==0 ? texelFetch(surfaces[0],p,0).r : texelFetch(surfaces[1],p,0).r)|0xff000000;
}
void main() {
    uvec2 p=gl_GlobalInvocationID.xy;
    if (p.x>=display.width || p.y>=display.height) return;
    const uint raw=compose_circuits(p.x,p.y);
    imageStore(current_field,ivec2(p),uvec4(raw));
    // Sub-pixel drawing-offset jitter cycling over three images (a temporal
    // anti-aliasing pattern meant to be integrated by an interlaced display)
    // makes static edges hop between rows. Once three composed images exist, a
    // texel equal in all of them is static and is shown as composed; one that
    // differs from the last image but equals the image three back is such a
    // cycle and is shown as its mean. Neither gets a field-line shift or
    // interpolation from jittering neighbours. Two-field content alternates
    // (period two) and genuine motion breaks both patterns; they are left to
    // the reconstruction below.
    if ((display.history_valid&4)!=0) {
        const uint a=texelFetch(previous[0],ivec2(p),0).r,b=texelFetch(previous[1],ivec2(p),0).r;
        const uint c=texelFetch(previous[2],ivec2(p),0).r;
        if (raw==a && raw==b && raw==c) { imageStore(reconstructed,ivec2(p),uvec4(raw)); return; }
        if (raw!=a && raw==c) {
            uint mean=0xff000000u;
            for (uint shift=0;shift<24;shift+=8) {
                const uint sum=((raw>>shift)&255u)+((a>>shift)&255u)+((b>>shift)&255u);
                mean|=((sum+1u)/3u)<<shift;
            }
            imageStore(reconstructed,ivec2(p),uvec4(mean));
            return;
        }
    }
    // Repainting the same source field is not new motion. Resource revisions
    // can change for redraws or overlapping views outside the displayed area.
    // Retain the prior reconstruction only where all contributing source rows
    // are exactly unchanged; neighboring changes still use spatial/temporal
    // reconstruction below. Each invocation owns one output texel.
    bool unchanged=(display.history_valid&2)!=0;
    if (unchanged) {
        int row=int(p.y/2*2);
        for (int offset=-2;offset<=2;offset+=2) {
            uint y=uint(clamp(row+offset,0,int(display.height)-1));
            unchanged=unchanged && compose_circuits(p.x,y)==texelFetch(previous[0],ivec2(p.x,y),0).r;
        }
    }
    uint color=compose_display(p.x,p.y),phase=display.field==2 ? 1:0;
    if ((display.history_valid&1)!=0 && p.y>=phase && ((p.y-phase)&1)!=0) {
        // Weave only when BOTH parities are unchanged in a small vertical
        // neighborhood. Motion, fades, startup and discontinuities use the
        // current field's spatial reconstruction, without temporal trails.
        bool stable=true;
        int row=int((p.y-phase)/2*2);
        for (int offset=-2;offset<=2;offset+=2) {
            uint y=uint(clamp(row+offset,0,int(display.height)-1));
            ivec2 q=ivec2(p.x,y);
            stable=stable && compose_circuits(p.x,y)==texelFetch(previous[1],q,0).r;
            stable=stable && texelFetch(previous[0],q,0).r==texelFetch(previous[2],q,0).r;
        }
        if (stable) {
            uint previous_phase=1-phase;
            uint y=p.y>previous_phase ? p.y-previous_phase : 0;
            color=texelFetch(previous[0],ivec2(p.x,y),0).r;
            imageStore(reconstructed,ivec2(p),uvec4(color)); return;
        }
    }
    if (!unchanged || ((display.history_valid&1)!=0 && p.y>=phase && ((p.y-phase)&1)==0))
        imageStore(reconstructed,ivec2(p),uvec4(color));
}
