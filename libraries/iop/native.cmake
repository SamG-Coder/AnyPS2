function(anyps2_bind_iop target)
    set(ANYPS2_IOP_PROJECT "" CACHE PATH "Converted LLVM IOP bundle for reset startup investigation")
    if(NOT ANYPS2_IOP_PROJECT)
        return()
    endif()
    include("${ANYPS2_ROOT}/libraries/audio/native.cmake")
    if(NOT TARGET nt_audio)
        anyps2_add_audio(nt_audio)
    endif()
    include("${ANYPS2_ROOT}/libraries/usb/native.cmake")
    if(NOT TARGET nt_usb)
        anyps2_add_usb(nt_usb)
    endif()
    target_link_libraries(${target} PRIVATE nt_audio nt_usb)
    foreach(input IN ITEMS generated.ll module_metadata.cpp module.data)
        if(NOT EXISTS "${ANYPS2_IOP_PROJECT}/${input}")
            message(FATAL_ERROR "Incomplete converted IOP project: ${input}")
        endif()
    endforeach()
    include("${ANYPS2_ROOT}/cmake/llvm_objects.cmake")
    anyps2_add_llvm_library(${target}_iop "${ANYPS2_IOP_PROJECT}")
    target_link_libraries(${target} PRIVATE ${target}_iop)
    target_sources(${target} PRIVATE "${ANYPS2_IOP_PROJECT}/module_metadata.cpp")
    target_sources(${target} PRIVATE "${ANYPS2_ROOT}/libraries/disc/src/reboot_image.cpp")
    target_include_directories(${target} PRIVATE "${ANYPS2_ROOT}/libraries/iop/include" "${ANYPS2_ROOT}/libraries/runtime/include")
    target_compile_definitions(${target} PRIVATE ANYPS2_NATIVE_IOP=1)
endfunction()
